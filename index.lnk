<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Pa que rinda la platica</title>
<meta name="description" content="Finanzas por quincena, por tu cuenta o en pareja: obligaciones, gastos extra, ingresos y ahorro.">
<meta name="theme-color" content="#C92C66">
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" href="icon-192.png" type="image/png">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="La platica">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Nunito:wght@400;600;700;800&display=swap">
<style>
/* Layout: cabecera con los dos nombres, tarjeta frambuesa con lo libre para gastar y su reparto en una tarjetica clara, y cuatro pestañas redondeadas. */
:root{
  --bg:#FFF4F7; --glow-1:#FFE1D6; --glow-2:#EFE3FF; --surface:#FFFFFF; --surface-2:#FFF1F5;
  --ink:#3B1F3F; --ink-2:#6B4E70; --muted:#957A99; --line:#F5DFE8;
  --accent:#D6336C; --accent-ink:#FFFFFF; --accent-soft:#FFE4ED;
  --income:#0E8F74; --good:#12A08A; --expense:#E5383B; --saving:#C27C06;
  --k1:#E64980; --k2:#2C8DB5; --av-ink:#FFFFFF;
  --seg-fijo:#7B61D9; --seg-gasto:#E64980; --seg-ahorro:#D98E0F; --seg-libre:#12A08A;
  --hero-a:#8E2463; --hero-b:#C92C66; --hero-fg:#FFFFFF; --hero-muted:#FFE9F0; --hero-glass:rgba(255,255,255,.16); --hero-edge:rgba(255,255,255,.28);
  --hero-ok:#B9F5DD; --hero-warn:#FFE08A; --hero-crit:#FFD3D3;
  --ico-bs:92%; --ico-bl:94%; --ico-fs:62%; --ico-fl:38%;
  --shadow:0 1px 2px rgba(142,36,99,.05),0 10px 30px rgba(142,36,99,.08);
  --display:"Fredoka","Trebuchet MS",system-ui,sans-serif;
  --body:"Nunito",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  --r:22px;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#1C1220; --glow-1:#3A1B2E; --glow-2:#2A1F45; --surface:#2A1A2E; --surface-2:#35223A;
    --ink:#FBEFF4; --ink-2:#DBC4D8; --muted:#A88EAA; --line:#47314C;
    --accent:#FF7BA5; --accent-ink:#2A0F1C; --accent-soft:#4A2238;
    --income:#3FD1A0; --good:#1FA89B; --expense:#F0585A; --saving:#F5B942;
    --k1:#E65492; --k2:#3E9CC4;
    --seg-fijo:#8A74E6; --seg-gasto:#E65492; --seg-ahorro:#BE8A0C; --seg-libre:#1FA89B;
    --hero-a:#5E1846; --hero-b:#A8275A;
    --ico-bs:45%; --ico-bl:24%; --ico-fs:85%; --ico-fl:80%;
    --shadow:0 1px 2px rgba(0,0,0,.3),0 10px 30px rgba(0,0,0,.28);
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#1C1220; --glow-1:#3A1B2E; --glow-2:#2A1F45; --surface:#2A1A2E; --surface-2:#35223A;
  --ink:#FBEFF4; --ink-2:#DBC4D8; --muted:#A88EAA; --line:#47314C;
  --accent:#FF7BA5; --accent-ink:#2A0F1C; --accent-soft:#4A2238;
  --income:#3FD1A0; --good:#1FA89B; --expense:#F0585A; --saving:#F5B942;
  --k1:#E65492; --k2:#3E9CC4;
  --seg-fijo:#8A74E6; --seg-gasto:#E65492; --seg-ahorro:#BE8A0C; --seg-libre:#1FA89B;
  --hero-a:#5E1846; --hero-b:#A8275A;
  --ico-bs:45%; --ico-bl:24%; --ico-fs:85%; --ico-fl:80%;
  --shadow:0 1px 2px rgba(0,0,0,.3),0 10px 30px rgba(0,0,0,.28);
  color-scheme:dark;
}
*{box-sizing:border-box}
body{background:var(--bg);background-image:radial-gradient(60rem 28rem at 105% -8%,var(--glow-1),transparent 62%),radial-gradient(44rem 26rem at -12% 6%,var(--glow-2),transparent 62%);background-repeat:no-repeat;color:var(--ink);font-family:var(--body);font-size:15.5px;line-height:1.45;-webkit-font-smoothing:antialiased}
.app{max-width:1080px;margin:0 auto;padding-inline:clamp(16px,3vw,28px);padding-block:20px 56px;display:flex;flex-direction:column;gap:18px}
h1,h2,h3,p{margin:0}
h2{font-family:var(--display);font-weight:600;font-size:20px;letter-spacing:-.005em;text-wrap:balance}
.num{font-variant-numeric:tabular-nums}
button,input,select{font:inherit;color:inherit}
:focus-visible{outline:2.5px solid var(--accent);outline-offset:2px}

/* Encabezado */
.top{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.brand{margin-right:auto;display:flex;align-items:center;gap:12px;min-width:0}
.duo{display:flex;flex:none}
.av{width:40px;height:40px;border-radius:50%;display:grid;place-items:center;color:var(--av-ink);font:600 14px var(--display);border:3px solid var(--bg);background:var(--k1)}
.av.k2{background:var(--k2);margin-left:-12px}
.bt{min-width:0;line-height:1.15}
.bt strong{display:block;font-family:var(--display);font-weight:600;font-size:21px;letter-spacing:-.01em;text-wrap:balance}
.bt small{color:var(--ink-2);font-size:13.5px;font-weight:700}
.qnav{display:flex;align-items:center;gap:6px;background:var(--surface);border:1px solid var(--line);border-radius:999px;padding:4px;box-shadow:var(--shadow)}
.qnav .mid{padding:0 10px;text-align:center;min-width:150px;line-height:1.2}
.qnav strong{display:block;font-family:var(--display);font-weight:600;font-size:15px}
.qnav small{color:var(--muted);font-size:12px;font-weight:600}
.iconbtn{width:36px;height:36px;border-radius:50%;border:0;background:transparent;display:grid;place-items:center;cursor:pointer;color:var(--ink-2)}
.iconbtn:hover{background:var(--accent-soft);color:var(--accent)}
.iconbtn svg{width:18px;height:18px}
.btn{border:1.5px solid var(--line);background:var(--surface);border-radius:999px;padding:10px 18px;font-weight:800;cursor:pointer;min-height:46px;display:inline-flex;align-items:center;justify-content:center;gap:8px}
.btn:hover{border-color:var(--accent)}
.btn svg{width:17px;height:17px}
.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-ink);box-shadow:0 8px 16px -8px var(--accent)}
.btn.primary:hover{filter:brightness(1.07)}
.btn.small{min-height:38px;padding:6px 14px;font-size:13.5px}
.btn.round{border-radius:999px}
.btn:disabled{opacity:.5;cursor:not-allowed;box-shadow:none}
.link{border:0;background:none;padding:0;color:var(--accent);font-weight:800;cursor:pointer;text-decoration:underline;font-size:inherit}

.notice{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:10px 14px;font-size:13.5px;color:var(--ink-2);display:flex;gap:10px;align-items:center}
.notice svg{width:18px;height:18px;flex:none;color:var(--saving)}

/* Bienvenida */
.onboard{background:var(--surface);border:2px dashed var(--accent);border-radius:var(--r);padding:22px;display:grid;gap:14px}
.onboard p{color:var(--ink-2);max-width:60ch}
.onboard .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;align-items:end}

/* Tarjeta principal */
.hero{position:relative;overflow:hidden;background:linear-gradient(135deg,var(--hero-a),var(--hero-b));color:var(--hero-fg);border-radius:28px;padding:clamp(18px,3vw,28px);display:grid;gap:18px;box-shadow:0 18px 40px -18px var(--hero-b)}
.hero::before,.hero::after{content:"";position:absolute;border-radius:50%;background:var(--hero-glass);pointer-events:none}
.hero::before{width:260px;height:260px;right:-70px;top:-110px}
.hero::after{width:150px;height:150px;left:38%;bottom:-90px}
.hero>*{position:relative}
.hero-top{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,300px);gap:20px;align-items:stretch}
.hero-label{color:var(--hero-muted);font-family:var(--display);font-size:17px;font-weight:500}
.hero-big{font-family:var(--display);font-weight:600;font-size:clamp(44px,10.5vw,74px);line-height:1;letter-spacing:-.02em;margin:6px 0 10px;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.hero-sub{color:var(--hero-muted);font-size:14.5px;max-width:52ch;font-weight:600}
.pill{display:inline-flex;align-items:center;gap:6px;border-radius:999px;padding:6px 13px 6px 9px;font-size:13.5px;font-weight:800;background:var(--hero-glass);border:1px solid var(--hero-edge);color:var(--hero-fg);margin-top:12px}
.pill svg{width:17px;height:17px}
.pill.ok svg{color:var(--hero-ok)} .pill.warn svg{color:var(--hero-warn)} .pill.crit svg{color:var(--hero-crit)}
.today{background:var(--hero-glass);border:1px solid var(--hero-edge);border-radius:20px;padding:16px;display:flex;flex-direction:column;justify-content:center;gap:4px}
.today .k{color:var(--hero-muted);font-size:13.5px;font-weight:800}
.today .v{font-family:var(--display);font-weight:600;font-size:32px;font-variant-numeric:tabular-nums;line-height:1.1}
.today .d{color:var(--hero-muted);font-size:13.5px;font-weight:600}
.today .btn{align-self:flex-start;margin-top:8px;background:var(--hero-fg);color:var(--hero-a);border-color:var(--hero-fg)}
.hero-card{background:var(--surface);color:var(--ink);border-radius:20px;padding:16px}
.split{display:flex;gap:2px;height:16px;border-radius:8px;overflow:hidden;background:var(--surface-2)}
.split span{min-width:0;border-radius:4px}
.split .f{background:var(--seg-fijo)} .split .g{background:var(--seg-gasto)} .split .a{background:var(--seg-ahorro)} .split .l{background:var(--seg-libre)}
.legend{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px 14px;margin-top:12px}
.legend div{min-width:0}
.legend .k{display:flex;align-items:center;gap:6px;color:var(--ink-2);font-size:13px;font-weight:700}
.legend .k i{width:10px;height:10px;border-radius:50%;flex:none}
.legend .v{font-weight:800;font-size:16.5px;font-variant-numeric:tabular-nums;overflow-wrap:anywhere}

/* Pestañas */
.tabs{display:flex;gap:4px;background:var(--surface);border:1px solid var(--line);border-radius:999px;padding:5px;box-shadow:var(--shadow)}
.tab{flex:1;border:0;background:transparent;border-radius:999px;padding:10px 8px;font-weight:800;color:var(--ink-2);cursor:pointer;min-height:44px;display:flex;align-items:center;justify-content:center;gap:8px}
.tab svg{width:18px;height:18px;flex:none}
.tab[aria-selected="true"]{background:var(--accent);color:var(--accent-ink);box-shadow:0 8px 16px -8px var(--accent)}
.panel{display:grid;gap:18px;scroll-margin-top:12px}
.two{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:18px;align-items:start}
.colx{display:flex;flex-direction:column;gap:18px;min-width:0}
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:20px;min-width:0;display:flex;flex-direction:column;gap:14px;box-shadow:var(--shadow)}
.card-h{display:flex;align-items:baseline;justify-content:space-between;gap:10px;flex-wrap:wrap}
.card-h .aside{color:var(--muted);font-size:13.5px;font-weight:700}
.hint{color:var(--muted);font-size:14px;font-weight:600}

/* Formularios */
.field{display:flex;flex-direction:column;gap:6px;min-width:0}
.field>span,legend{font-size:13.5px;font-weight:800;color:var(--ink-2)}
fieldset{border:0;padding:0;margin:0;min-width:0;display:flex;flex-direction:column;gap:6px}
input[type="text"],input[type="date"],select,.moneybox{border:1.5px solid var(--line);background:var(--surface-2);border-radius:14px;padding:11px 13px;font-size:16px;font-weight:600;min-height:48px;width:100%;min-width:0}
input:focus-visible,select:focus-visible,.moneybox:focus-within{outline:2.5px solid var(--accent);outline-offset:0;border-color:var(--accent)}
.moneybox{display:flex;align-items:center;gap:6px;padding-block:0}
.moneybox b{color:var(--muted);font-weight:800}
.moneybox input{border:0;background:transparent;padding:0;min-height:44px;font-weight:800;font-variant-numeric:tabular-nums;outline:0;flex:1;border-radius:0}
.moneybox.big input{font-family:var(--display);font-weight:600;font-size:28px;min-height:58px}
.moneybox.big b{font-family:var(--display);font-size:24px;font-weight:600}
.row2{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,170px);gap:12px}
.grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.check{display:flex;gap:8px;align-items:center;font-size:14px;font-weight:600;color:var(--ink-2)}
.check input{width:18px;height:18px;accent-color:var(--accent);flex:none}
.chips{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px}
.chip{position:relative}
.chip input{position:absolute;opacity:0;inset:0;width:100%;height:100%;cursor:pointer;margin:0}
.chip span{display:flex;flex-direction:column;align-items:center;gap:5px;text-align:center;border:1.5px solid var(--line);border-radius:16px;padding:10px 6px;font-size:12.5px;font-weight:800;color:var(--ink-2);line-height:1.2;height:100%;background:var(--surface)}
.chip svg{width:21px;height:21px}
.chip input:checked+span{background:var(--accent-soft);border-color:var(--accent);color:var(--ink)}
.chip input:checked+span svg{color:var(--accent)}
.chip input:focus-visible+span{outline:2.5px solid var(--accent);outline-offset:2px}
.seg{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.seg.two-opt{grid-template-columns:repeat(2,minmax(0,1fr))}
.seg .chip span{flex-direction:row;justify-content:center;gap:8px;padding:12px 6px;font-size:14px;border-radius:999px}
.chip span[data-who]::before{content:"";width:10px;height:10px;border-radius:50%;background:var(--k1);flex:none}
.chip span[data-who="esp"]::before{background:var(--k2)}
.actions{display:flex;gap:10px;flex-wrap:wrap}
.actions .primary{flex:1;min-width:160px}

/* Gráfica diaria */
.plot{position:relative;height:150px;display:grid;grid-template-columns:repeat(var(--n),minmax(0,1fr));border-bottom:1px solid var(--line)}
.dcol{appearance:none;border:0;background:transparent;padding:0;height:100%;display:flex;align-items:flex-end;justify-content:center;cursor:pointer;border-radius:8px 8px 0 0}
.dcol:hover,.dcol.sel{background:var(--surface-2)}
.dcol .bar{width:min(62%,18px);border-radius:5px 5px 0 0;background:var(--good);display:block}
.dcol.over .bar{background:var(--expense)}
.ref{position:absolute;left:0;right:0;border-top:1.5px dashed var(--muted);pointer-events:none}
.ref span{position:absolute;right:0;bottom:3px;font-size:11.5px;font-weight:800;color:var(--ink-2);background:var(--surface);padding:1px 6px;border-radius:6px;white-space:nowrap}
.xaxis{display:grid;grid-template-columns:repeat(var(--n),minmax(0,1fr));font-size:10.5px;font-weight:700;color:var(--muted);text-align:center;margin-top:5px;font-variant-numeric:tabular-nums}
.xaxis .is-today{color:var(--ink);font-weight:800}
.readout{background:var(--surface-2);border-radius:14px;padding:9px 13px;font-size:14px;font-weight:600;color:var(--ink-2);display:flex;justify-content:space-between;gap:10px;flex-wrap:wrap}
.readout b{color:var(--ink);font-variant-numeric:tabular-nums}
.keys{display:flex;gap:14px;flex-wrap:wrap;font-size:13px;font-weight:600;color:var(--ink-2)}
.keys span{display:inline-flex;align-items:center;gap:6px}
.keys i{width:10px;height:10px;border-radius:50%;display:inline-block}
.keys .dash{width:16px;height:0;border-top:1.5px dashed var(--muted);border-radius:0}

/* Categorías */
.cats{display:grid;gap:13px}
.cat{display:grid;grid-template-columns:40px minmax(0,1fr) auto;gap:11px;align-items:center}
.ico{width:40px;height:40px;border-radius:14px;background:hsl(var(--h,330) var(--ico-bs) var(--ico-bl));color:hsl(var(--h,330) var(--ico-fs) var(--ico-fl));display:grid;place-items:center;flex:none}
.ico svg{width:20px;height:20px}
.cat .nm{display:flex;justify-content:space-between;gap:8px;font-weight:800;font-size:14.5px}
.cat .nm small{color:var(--muted);font-weight:700}
.track{height:9px;border-radius:5px;background:var(--surface-2);margin-top:6px;overflow:hidden}
.track span{display:block;height:100%;border-radius:5px;background:var(--accent)}
.cat .amt{font-weight:800;font-variant-numeric:tabular-nums}

/* Movimientos y obligaciones */
.day{display:grid;gap:4px}
.day+.day{margin-top:8px}
.day-h{display:flex;justify-content:space-between;gap:10px;font-size:12.5px;font-weight:800;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;padding:4px 2px;border-bottom:1px solid var(--line)}
.movs{list-style:none;margin:0;padding:0}
.mov{display:grid;grid-template-columns:40px minmax(0,1fr) auto auto;gap:11px;align-items:center;padding:10px 2px}
.mov+.mov{border-top:1px solid var(--line)}
.mov .t{min-width:0}
.mov .t strong{display:block;font-weight:800;overflow-wrap:anywhere}
.mov .t small{color:var(--muted);font-size:13px;font-weight:600}
.dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:5px;background:var(--k1)}
.dot.k2{background:var(--k2)}
.who{white-space:nowrap}
.mov .amt{font-weight:800;font-variant-numeric:tabular-nums;white-space:nowrap}
.mov .amt.in{color:var(--income)}
.mov .ops{display:flex;gap:2px;align-items:center}
.mov .ops .iconbtn{width:32px;height:32px}
.mov .ops .iconbtn svg{width:16px;height:16px}
.mov.off .t strong,.mov.off .amt{color:var(--muted)}
.mov.paying{display:block}
.payform{display:grid;gap:10px;background:var(--surface-2);border-radius:18px;padding:14px}
.payform .moneybox,.payform .chip span{background:var(--surface)}
.payform .chip input:checked+span{background:var(--accent-soft)}
.prog{height:10px;border-radius:5px;background:var(--surface-2);overflow:hidden;margin-bottom:6px}
.prog span{display:block;height:100%;border-radius:5px;background:var(--good)}
.obtot{display:flex;justify-content:space-between;align-items:baseline;gap:10px;border-top:2px solid var(--line);padding-top:12px;flex-wrap:wrap;font-weight:700}
.obtot b{font-family:var(--display);font-weight:600;font-size:24px;font-variant-numeric:tabular-nums}
.obtot small{color:var(--muted);display:block;font-size:13px;font-weight:600}
.confirm{display:flex;gap:6px;align-items:center;font-size:13px;font-weight:800}
.empty{border:2px dashed var(--line);border-radius:18px;padding:18px;text-align:center;color:var(--muted);font-size:14px;font-weight:600}
.empty strong{display:block;color:var(--ink-2);margin-bottom:2px;font-weight:800}

/* Ingresos, ahorro y mitades */
.stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.stat{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:18px;min-width:0;box-shadow:var(--shadow)}
.stat .k{font-size:13.5px;color:var(--ink-2);font-weight:800;display:flex;align-items:center;gap:8px}
.stat .v{font-family:var(--display);font-weight:600;font-size:28px;font-variant-numeric:tabular-nums;margin-top:6px;overflow-wrap:anywhere}
.stat .d{font-size:13.5px;color:var(--muted);margin-top:2px;font-weight:600}
.stat .track span{background:var(--saving)}
.quick{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;background:var(--accent-soft);border-radius:18px;padding:12px 14px}
.quick p{font-size:14px;font-weight:700;color:var(--ink)}
.quick div{display:flex;gap:8px;flex-wrap:wrap}
.half{display:grid;gap:16px}
.hrow .nm{display:flex;justify-content:space-between;gap:10px;font-weight:800;flex-wrap:wrap}
.hrow .nm span:last-child{font-variant-numeric:tabular-nums}
.hrow small{color:var(--muted);font-size:13px;font-weight:600}
.htrack{position:relative;height:12px;border-radius:6px;background:var(--surface-2);margin:8px 0 4px}
.htrack span{display:block;height:100%;border-radius:6px;background:var(--k1)}
.htrack span.k2{background:var(--k2)}
.htrack i{position:absolute;left:50%;top:-4px;bottom:-4px;width:2px;margin-left:-1px;background:var(--ink-2);border-radius:1px}
.verdict{background:var(--accent-soft);border-radius:18px;padding:13px 15px;font-size:15px;font-weight:600}
.verdict b{font-variant-numeric:tabular-nums;font-weight:800}
.tablewrap{overflow-x:auto}
table{border-collapse:collapse;width:100%;min-width:520px;font-size:14.5px}
th{font-size:12px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);text-align:right;padding:8px 10px;border-bottom:1px solid var(--line);font-weight:800}
td{padding:12px 10px;border-bottom:1px solid var(--line);text-align:right;font-variant-numeric:tabular-nums;font-weight:600}
th:first-child,td:first-child{text-align:left}
tbody tr{cursor:pointer}
tbody tr:hover,tbody tr.cur{background:var(--surface-2)}
td .qbtn{border:0;background:transparent;font-weight:800;cursor:pointer;padding:0;text-align:left}
.tag{display:inline-flex;align-items:center;gap:5px;border:1px solid var(--line);border-radius:999px;padding:3px 10px 3px 7px;font-size:12.5px;font-weight:800;white-space:nowrap}
.tag svg{width:14px;height:14px}
.tag.ok svg{color:var(--income)} .tag.no svg{color:var(--expense)} .tag.run svg{color:var(--saving)}

dialog{border:1px solid var(--line);border-radius:24px;background:var(--surface);color:var(--ink);padding:22px;width:min(460px,calc(100vw - 32px));box-shadow:var(--shadow)}
dialog::backdrop{background:rgba(40,12,30,.55)}
dialog form{display:grid;gap:14px}
.toast{position:fixed;left:50%;bottom:calc(18px + env(safe-area-inset-bottom,0px));transform:translate(-50%,20px);background:var(--ink);color:var(--bg);padding:11px 18px;border-radius:999px;font-weight:800;font-size:14px;opacity:0;pointer-events:none;transition:opacity .2s,transform .2s;max-width:calc(100vw - 32px);text-align:center;z-index:20}
.toast.on{opacity:1;transform:translate(-50%,0)}
@media (prefers-reduced-motion:reduce){.toast{transition:none}}

@media (max-width:860px){
  .hero-top{grid-template-columns:minmax(0,1fr)}
  .two{display:flex;flex-direction:column;align-items:stretch}
  .colx{display:contents}
  #card-obls{order:1} #f-ob{order:2} #card-obtpl{order:3}
  #f-gas{order:1} #card-chart{order:2} #card-list{order:3} #card-cats{order:4}
  #f-ing{order:1} #card-tipos{order:2} #card-inglist{order:3}
  .stats{grid-template-columns:minmax(0,1fr)}
}
@media (max-width:520px){
  .legend{grid-template-columns:repeat(2,minmax(0,1fr))}
  .brand{flex:1 1 calc(100% - 56px)}
  .bt strong{font-size:19px}
  #btn-settings{padding:0;width:44px;min-height:44px;order:1}
  #btn-settings span{display:none}
  .qnav{order:3;flex:1 1 0;min-width:0}
  .qnav .mid{flex:1;min-width:0}
  #q-today{order:4}
  .row2{grid-template-columns:minmax(0,1fr)}
  .app{padding-block-end:108px}
  .tabs{position:fixed;left:0;right:0;bottom:0;z-index:15;border-radius:24px 24px 0 0;border-width:1px 0 0;padding:7px 8px calc(7px + env(safe-area-inset-bottom,0px));box-shadow:0 -8px 24px rgba(40,12,30,.14)}
  .tab{flex-direction:column;gap:2px;font-size:12.5px;min-height:54px;padding:6px 2px;border-radius:18px}
  .tab svg{width:22px;height:22px}
  .toast{bottom:calc(88px + env(safe-area-inset-bottom,0px))}
  .hero{border-radius:24px;gap:14px}
  .today{padding:14px}
  .card{padding:16px}
  .mov{gap:9px}
  .obs .mov:not(.paying){grid-template-columns:40px minmax(0,1fr) auto;row-gap:6px}
  .obs .mov .ico,.obs .mov .t{grid-row:1 / span 2;align-self:center}
  .obs .mov .amt{grid-column:3;grid-row:1;justify-self:end}
  .obs .mov>.btn{grid-column:3;grid-row:2;justify-self:end}
  .mov .ops .iconbtn{width:30px;height:30px}
  .chips{grid-template-columns:repeat(2,minmax(0,1fr))}
  .chips .chip span{flex-direction:row;justify-content:flex-start;text-align:left;gap:8px;padding:10px}
}

/* Base del documento (versión web independiente) */
:root{padding:env(safe-area-inset-top,0px) 0 env(safe-area-inset-bottom,0px)}
html{-webkit-text-size-adjust:100%}
body{margin:0;min-height:100vh}
[hidden]{display:none!important}
img{max-width:100%}
input[type="email"],input[type="password"]{border:1.5px solid var(--line);background:var(--surface-2);border-radius:14px;padding:11px 13px;font-size:16px;font-weight:600;min-height:48px;width:100%;min-width:0}

/* Entrada con correo y elección de espacio */
.gate{min-height:92vh;display:grid;place-items:center;padding-inline:16px;padding-block:24px}
.gate-card{width:min(430px,100%);background:var(--surface);border:1px solid var(--line);border-radius:28px;padding:26px;display:grid;gap:14px;box-shadow:var(--shadow)}
.gate-card.center{justify-items:center;text-align:center}
.gate-card h1{font-family:var(--display);font-weight:600;font-size:26px;line-height:1.15;text-wrap:balance}
.logo{width:56px;height:56px;border-radius:18px;background:linear-gradient(135deg,var(--hero-a),var(--hero-b));color:var(--hero-fg);display:grid;place-items:center;font:600 28px var(--display)}
.gate-tabs{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px;background:var(--surface-2);border-radius:999px;padding:4px}
.gtab{border:0;background:transparent;border-radius:999px;padding:10px;font-weight:800;color:var(--ink-2);cursor:pointer;min-height:42px}
.gtab[aria-selected="true"]{background:var(--surface);color:var(--ink);box-shadow:var(--shadow)}
.msg{border-radius:14px;padding:10px 13px;font-size:14px;font-weight:700;background:var(--surface-2);color:var(--ink);border:1.5px solid var(--line)}
.msg.err{border-color:var(--expense)}
.msg.ok{border-color:var(--good)}
.or{display:flex;align-items:center;gap:10px;color:var(--muted);font-weight:700;font-size:13px}
.or::before,.or::after{content:"";flex:1;height:1px;background:var(--line)}
.joinrow{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;align-items:end}
.gate-card .link{justify-self:center}
.acct{display:grid;gap:10px;border-top:1px solid var(--line);padding-top:14px}
.acct b{overflow-wrap:anywhere}
.invite{display:flex;align-items:center;gap:10px;flex-wrap:wrap;background:var(--surface-2);border-radius:16px;padding:10px 14px}
.invite span{font-size:13.5px;font-weight:800;color:var(--ink-2)}
.invite b{font-family:var(--display);font-size:22px;letter-spacing:.12em;margin-right:auto}
</style>
</head>
<body>
<section class="gate" id="scr-load">
  <div class="gate-card center"><div class="logo" aria-hidden="true">$</div><p class="hint">Cargando…</p></div>
</section>

<section class="gate" id="scr-auth" hidden>
  <form class="gate-card" id="f-auth" novalidate>
    <div class="logo" aria-hidden="true">$</div>
    <h1>Pa que rinda la platica</h1>
    <p class="hint" id="au-sub">Tus cuentas claras, quincena a quincena.</p>
    <div class="gate-tabs" id="au-tabs" role="tablist" aria-label="Entrar o crear cuenta">
      <button type="button" class="gtab" role="tab" data-au="in" aria-selected="true">Entrar</button>
      <button type="button" class="gtab" role="tab" data-au="up" aria-selected="false">Crear cuenta</button>
    </div>
    <label class="field" id="au-email-f"><span>Correo</span><input type="email" id="au-email" autocomplete="email" inputmode="email" placeholder="tucorreo@ejemplo.com"></label>
    <label class="field" id="au-pass-f"><span id="au-pass-l">Contraseña</span><input type="password" id="au-pass" autocomplete="current-password" placeholder="Mínimo 6 caracteres"></label>
    <p class="msg" id="au-msg" role="status" hidden></p>
    <button class="btn primary" type="submit" id="au-submit">Entrar</button>
    <button class="link" type="button" id="au-forgot">Olvidé mi contraseña</button>
  </form>
</section>

<section class="gate" id="scr-hogar" hidden>
  <div class="gate-card">
    <div class="logo" aria-hidden="true">$</div>
    <h1>¿Cómo quieres empezar?</h1>
    <p class="hint">Tu espacio guarda tus cuentas. Si tu pareja ya usa la app, únete al suyo con el código que aparece en sus Ajustes y verán los mismos datos.</p>
    <button class="btn primary" type="button" id="hg-crear">Empezar mi propio espacio</button>
    <div class="or"><span>o</span></div>
    <form id="f-join" class="joinrow" novalidate>
      <label class="field"><span>Código de tu pareja</span><input type="text" id="hg-code" maxlength="6" autocapitalize="characters" autocomplete="off" placeholder="Ej.: A1B2C3"></label>
      <button class="btn" type="submit" id="hg-join">Unirme</button>
    </form>
    <p class="msg" id="hg-msg" role="status" hidden></p>
    <button class="link" type="button" id="hg-out">Cerrar sesión</button>
  </div>
</section>

<div class="app" id="app-main" hidden>
  <header class="top">
    <div class="brand"><span class="duo" aria-hidden="true"><b class="av" id="av-yo">$</b><b class="av k2" id="av-esp" hidden></b></span><span class="bt"><strong>Pa que rinda la platica</strong><small id="brand-names">Tu plata clarita, quincena a quincena</small></span></div>
    <div class="qnav">
      <button class="iconbtn" id="q-prev" type="button" aria-label="Quincena anterior"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 5l-7 7 7 7"/></svg></button>
      <div class="mid"><strong id="q-label">Quincena</strong><small id="q-sub">&nbsp;</small></div>
      <button class="iconbtn" id="q-next" type="button" aria-label="Quincena siguiente"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 5l7 7-7 7"/></svg></button>
    </div>
    <button class="btn small round" id="q-today" type="button" hidden>Ir a hoy</button>
    <button class="btn small round" id="btn-settings" type="button" aria-label="Ajustes"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h9M19 7h1M4 17h1M11 17h9"/><circle cx="16" cy="7" r="2.6"/><circle cx="8" cy="17" r="2.6"/></svg><span>Ajustes</span></button>
  </header>

  <div class="notice" id="notice" hidden></div>

  <form class="onboard" id="onboard" hidden>
    <h2>Hola, armemos tu app</h2>
    <p>Dime cómo te llamas y si la vas a usar por tu cuenta o en pareja. Con los ingresos, las obligaciones y la meta de ahorro, la app dice cada día cuánto se puede gastar sin tocar el ahorro. Todo se puede cambiar después en Ajustes.</p>
    <div class="grid">
      <label class="field"><span>¿Cómo te llamas?</span><input type="text" id="ob-nombre" maxlength="14" autocomplete="off" placeholder="Tu nombre"></label>
      <fieldset><legend>¿Cómo la vas a usar?</legend><div class="seg two-opt">
        <label class="chip"><input type="radio" name="ob-modo" id="ob-modo-solo" value="solo" checked><span>Por mi cuenta</span></label>
        <label class="chip"><input type="radio" name="ob-modo" id="ob-modo-par" value="pareja"><span>En pareja</span></label>
      </div></fieldset>
      <label class="field" data-ob-par hidden><span>Nombre de tu pareja</span><input type="text" id="ob-nombre-esp" maxlength="14" autocomplete="off" placeholder="Su nombre"></label>
      <label class="field"><span>Tu sueldo fijo por quincena (opcional)</span><div class="moneybox"><b>$</b><input type="text" id="ob-sueldo" inputmode="numeric" autocomplete="off" placeholder="0" data-money></div></label>
      <label class="field" data-ob-par hidden><span>Sueldo fijo de tu pareja (opcional)</span><div class="moneybox"><b>$</b><input type="text" id="ob-sueldo-esp" inputmode="numeric" autocomplete="off" placeholder="0" data-money></div></label>
      <label class="field"><span>Ahorro (% de lo que entra)</span><div class="moneybox"><input type="text" id="ob-meta" inputmode="numeric" autocomplete="off" value="10" maxlength="2"><b>%</b></div></label>
      <button class="btn primary" type="submit">Empezar</button>
    </div>
  </form>

  <section class="hero" id="hero" aria-live="polite"></section>

  <div class="tabs" role="tablist" aria-label="Secciones">
    <button class="tab" role="tab" id="t-fijos" data-tab="fijos" aria-selected="true" type="button">Fijos</button>
    <button class="tab" role="tab" id="t-gastos" data-tab="gastos" aria-selected="false" type="button">Extras</button>
    <button class="tab" role="tab" id="t-ingresos" data-tab="ingresos" aria-selected="false" type="button">Ingresos</button>
    <button class="tab" role="tab" id="t-ahorro" data-tab="ahorro" aria-selected="false" type="button">Resumen</button>
  </div>

  <!-- FIJOS -->
  <section class="panel" id="p-fijos" role="tabpanel" aria-labelledby="t-fijos">
    <div class="two">
      <div class="colx">
        <div class="card" id="card-obls">
          <div class="card-h"><h2>Obligaciones de esta quincena</h2><span class="aside num" id="obls-aside"></span></div>
          <div id="obls-list"></div>
        </div>
      </div>
      <div class="colx">
        <form class="card" id="f-ob" autocomplete="off">
          <div class="card-h"><h2 id="ob-title">Agregar una obligación fija</h2></div>
          <p class="hint" data-solo="Lo que pagas sí o sí: arriendo, servicios, cuotas. Aparece sola en la quincena que elijas." data-par="Lo que pagan sí o sí: arriendo, servicios, cuotas. Aparece sola en la quincena que elijas.">Lo que se paga sí o sí: arriendo, servicios, cuotas. Aparece sola en la quincena que elijas.</p>
          <div class="grid2">
            <label class="field"><span>Nombre</span><input type="text" id="obl-nombre" maxlength="40" placeholder="Ej.: administración"></label>
            <label class="field"><span>Valor</span><div class="moneybox"><b>$</b><input type="text" id="obl-monto" inputmode="numeric" placeholder="0" data-money></div></label>
            <label class="field"><span>¿En cuál quincena?</span><select id="obl-q"><option value="1">Primera · 1–15</option><option value="2">Segunda · 16–fin</option><option value="0">Las dos</option></select></label>
            <label class="field"><span>¿Cada cuánto?</span><select id="obl-cada"><option value="1">Cada mes</option><option value="2">Cada 2 meses</option></select></label>
            <label class="field"><span>Categoría</span><select id="obl-cat"></select></label>
            <label class="field" data-par-only><span>¿Quién suele pagarla?</span><select id="obl-w"><option value="yo" data-who="yo"></option><option value="esp" data-who="esp"></option></select></label>
          </div>
          <label class="check"><input type="checkbox" id="obl-aprox">El valor es aproximado (cambia cada vez)</label>
          <div class="actions">
            <button class="btn primary" type="submit" id="obl-submit">Agregar obligación</button>
            <button class="btn" type="button" id="obl-cancel" hidden>Cancelar</button>
          </div>
        </form>
        <div class="card" id="card-obtpl">
          <div class="card-h"><h2 data-solo="Todas tus obligaciones" data-par="Todas sus obligaciones">Todas las obligaciones</h2><span class="aside num" id="obtpl-aside"></span></div>
          <div id="obtpl-list"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- EXTRAS -->
  <section class="panel" id="p-gastos" role="tabpanel" aria-labelledby="t-gastos" hidden>
    <div class="two">
      <div class="colx">
        <form class="card" id="f-gas" autocomplete="off">
          <div class="card-h"><h2 id="gas-title">Registrar un gasto extra</h2></div>
          <label class="field"><span>¿Cuánto fue?</span><div class="moneybox big"><b>$</b><input type="text" id="gas-monto" inputmode="numeric" placeholder="0" data-money></div></label>
          <fieldset data-par-only><legend>¿Quién pagó?</legend><div class="seg two-opt">
            <label class="chip"><input type="radio" name="gas-w" id="gas-w-yo" value="yo" checked><span data-who="yo"></span></label>
            <label class="chip"><input type="radio" name="gas-w" id="gas-w-esp" value="esp"><span data-who="esp"></span></label>
          </div></fieldset>
          <fieldset><legend>¿En qué?</legend><div class="chips" id="gas-cats"></div></fieldset>
          <div class="row2">
            <label class="field"><span>Nota (opcional)</span><input type="text" id="gas-nota" maxlength="60" placeholder="Ej.: almuerzo, bus, mercado"></label>
            <label class="field"><span>Fecha</span><input type="date" id="gas-fecha"></label>
          </div>
          <div class="actions">
            <button class="btn primary" type="submit" id="gas-submit">Guardar gasto</button>
            <button class="btn" type="button" id="gas-cancel" hidden>Cancelar</button>
          </div>
        </form>
        <div class="card" id="card-list">
          <div class="card-h"><h2>Gastos extra de la quincena</h2><span class="aside num" id="list-total"></span></div>
          <div id="gas-list"></div>
        </div>
      </div>
      <div class="colx">
        <div class="card" id="card-chart">
          <div class="card-h"><h2>Gasto extra por día</h2><span class="aside" id="chart-aside"></span></div>
          <div id="daychart"></div>
        </div>
        <div class="card" id="card-cats">
          <div class="card-h"><h2>En qué se va la plata</h2><span class="aside">Fijos y extras</span></div>
          <div id="cat-list"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- INGRESOS -->
  <section class="panel" id="p-ingresos" role="tabpanel" aria-labelledby="t-ingresos" hidden>
    <div class="two">
      <div class="colx">
        <form class="card" id="f-ing" autocomplete="off">
          <div class="card-h"><h2 id="ing-title">Registrar un ingreso</h2></div>
          <div class="quick" id="quick-sueldo" hidden></div>
          <fieldset data-par-only><legend>¿De quién es?</legend><div class="seg two-opt">
            <label class="chip"><input type="radio" name="ing-w" id="ing-w-yo" value="yo" checked><span data-who="yo"></span></label>
            <label class="chip"><input type="radio" name="ing-w" id="ing-w-esp" value="esp"><span data-who="esp"></span></label>
          </div></fieldset>
          <fieldset><legend>Tipo de ingreso</legend><div class="seg" id="ing-tipos"></div></fieldset>
          <label class="field"><span>¿Cuánto entró?</span><div class="moneybox big"><b>$</b><input type="text" id="ing-monto" inputmode="numeric" placeholder="0" data-money></div></label>
          <div class="row2">
            <label class="field"><span>Nota (opcional)</span><input type="text" id="ing-nota" maxlength="60" placeholder="Ej.: comisión de un cierre"></label>
            <label class="field"><span>Fecha</span><input type="date" id="ing-fecha"></label>
          </div>
          <div class="actions">
            <button class="btn primary" type="submit" id="ing-submit">Guardar ingreso</button>
            <button class="btn" type="button" id="ing-cancel" hidden>Cancelar</button>
          </div>
        </form>
      </div>
      <div class="colx">
        <div class="card" id="card-tipos">
          <div class="card-h"><h2>Lo que entró esta quincena</h2><span class="aside num" id="ing-total"></span></div>
          <div id="tipo-list"></div>
        </div>
        <div class="card" id="card-inglist">
          <div class="card-h"><h2>Detalle de ingresos</h2></div>
          <div id="ing-list"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- RESUMEN -->
  <section class="panel" id="p-ahorro" role="tabpanel" aria-labelledby="t-ahorro" hidden>
    <div class="stats" id="ahorro-stats"></div>
    <div class="card" data-par-only>
      <div class="card-h"><h2>Cuentas a mitades</h2><span class="aside">Gastos de esta quincena</span></div>
      <div id="mitades"></div>
    </div>
    <div class="card">
      <div class="card-h"><h2>Quincena por quincena</h2><span class="aside">Toca una fila para abrirla</span></div>
      <div id="hist"></div>
    </div>
  </section>
</div>

<dialog id="dlg" aria-labelledby="dlg-h">
  <form id="f-cfg" method="dialog">
    <h2 id="dlg-h">Ajustes</h2>
    <fieldset><legend>¿Cómo usas la app?</legend><div class="seg two-opt"><label class="chip"><input type="radio" name="cfg-modo" id="cfg-modo-solo" value="solo"><span>Por mi cuenta</span></label><label class="chip"><input type="radio" name="cfg-modo" id="cfg-modo-par" value="pareja" checked><span>En pareja</span></label></div></fieldset>
    <div class="grid2"><label class="field"><span>Tu nombre</span><input type="text" id="cfg-n-yo" maxlength="14" autocomplete="off"></label><label class="field" data-cfg-par><span>Nombre de tu pareja</span><input type="text" id="cfg-n-esp" maxlength="14" autocomplete="off"></label></div>
    <label class="field"><span>Tu sueldo fijo por quincena</span><div class="moneybox"><b>$</b><input type="text" id="cfg-sueldo" inputmode="numeric" autocomplete="off" placeholder="0" data-money></div></label>
    <label class="field" data-cfg-par><span>Sueldo fijo de tu pareja por quincena</span><div class="moneybox"><b>$</b><input type="text" id="cfg-sueldo-esp" inputmode="numeric" autocomplete="off" placeholder="0" data-money></div></label>
    <fieldset><legend>Meta de ahorro por quincena</legend>
      <div class="seg two-opt">
        <label class="chip"><input type="radio" name="cfg-tipo" id="cfg-pct" value="pct" checked><span>% de los ingresos</span></label>
        <label class="chip"><input type="radio" name="cfg-tipo" id="cfg-fijo" value="monto"><span>Monto fijo</span></label>
      </div>
    </fieldset>
    <label class="field"><span id="cfg-valor-l">Porcentaje a ahorrar</span><div class="moneybox"><b id="cfg-pre">%</b><input type="text" id="cfg-valor" inputmode="numeric" autocomplete="off" placeholder="0"></div></label>
    <p class="hint">La meta se aparta de los ingresos antes de calcular lo que queda para gastar.</p>
    <div class="actions">
      <button class="btn primary" type="submit" id="cfg-save">Guardar ajustes</button>
      <button class="btn" type="button" id="cfg-cancel">Cancelar</button>
    </div>
    <div class="acct" id="acct" hidden>
      <p class="hint">Sesión iniciada con <b id="acct-email"></b></p>
      <div class="invite" data-cfg-par><span>Código para tu pareja</span><b id="acct-code"></b><button type="button" class="btn small" id="acct-copy">Copiar</button></div>
      <p class="hint" data-cfg-par>Tu pareja crea su cuenta con su correo, elige "Unirme" y escribe este código.</p>
      <button type="button" class="btn small" id="acct-out">Cerrar sesión</button>
    </div>
  </form>
</dialog>
<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js"></script>
<script src="config.js"></script>
<script>
(function(){
'use strict';
/*LOGIC-START*/
var MESES=['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
var DIAS=['dom','lun','mar','mié','jue','vie','sáb'];
function pad(n){return String(n).padStart(2,'0')}
function ymd(d){return d.getFullYear()+'-'+pad(d.getMonth()+1)+'-'+pad(d.getDate())}
function parseYmd(s){var p=s.split('-').map(Number);return new Date(p[0],p[1]-1,p[2])}
function validYmd(s){return /^\d{4}-\d{2}-\d{2}$/.test(s||'')&&ymd(parseYmd(s))===s}
function qidOf(s){var p=s.split('-');return 'q-'+p[0]+'-'+p[1]+'-'+(Number(p[2])<=15?1:2)}
function qRange(qid){
  var p=qid.split('-'),Y=Number(p[1]),M=Number(p[2]),h=Number(p[3]);
  var last=new Date(Y,M,0).getDate(),a=h===1?1:16,b=h===1?15:last;
  return {y:Y,m:M,h:h,first:a,last:b,days:b-a+1,start:p[1]+'-'+p[2]+'-'+pad(a),end:p[1]+'-'+p[2]+'-'+pad(b)};
}
function qShift(qid,n){
  var r=qRange(qid),i=r.y*24+(r.m-1)*2+(r.h-1)+n;
  var Y=Math.floor(i/24),rest=i-Y*24;
  return 'q-'+Y+'-'+pad(Math.floor(rest/2)+1)+'-'+(rest%2+1);
}
function qLabel(qid){var r=qRange(qid);return r.first+'–'+r.last+' '+MESES[r.m-1]+' '+r.y}
function dayLabel(s){var d=parseYmd(s);return DIAS[d.getDay()]+' '+d.getDate()+' '+MESES[d.getMonth()]}
function money(n){n=Math.round(n||0);return (n<0?'−':'')+'$'+Math.abs(n).toLocaleString('es-CO')}
function digits(s){var v=String(s||'').replace(/\D/g,'');return v?Number(v):0}
function vals(o){
  var out=[];if(!o)return out;
  Object.keys(o).forEach(function(id){var x=o[id];if(x&&typeof x.m==='number'&&typeof x.d==='string')out.push(Object.assign({id:id},x))});
  return out;
}
function metaOf(cfg,ing){
  if(!cfg||ing<=0)return 0;
  var v=Number(cfg.metaValor)||0;
  var m=cfg.metaTipo==='monto'?v:Math.round(ing*Math.min(v,100)/100);
  return Math.max(0,Math.min(m,ing));
}
function monthIdx(r){return r.y*12+r.m}
function oblsOf(cfg){
  var out=[],o=cfg&&cfg.obls;if(!o)return out;
  Object.keys(o).forEach(function(id){var x=o[id];if(x&&typeof x.m==='number'&&x.n)out.push(Object.assign({id:id},x))});
  out.sort(function(a,b){return (a.o||0)-(b.o||0)});
  return out;
}
/* 'on' = toca en esta quincena, 'off' = es de esta quincena pero este mes no toca, null = es de la otra quincena */
function obState(ob,r){
  if(Number(ob.q)&&Number(ob.q)!==r.h)return null;
  if(Number(ob.cada)===2&&(monthIdx(r)-(Number(ob.ref)||0))%2!==0)return 'off';
  return 'on';
}
function summarize(q,cfg,qid,today){
  var r=qRange(qid),ings=vals(q&&q.ing),gass=vals(q&&q.gas),ing=0,gas=0,extras=0,fijosPag=0,nExtras=0,i;
  var perDay=[],cntDay=[],byCat={},byTipo={},paid={},who={yo:{ing:0,gas:0},esp:{ing:0,gas:0}};
  for(i=0;i<r.days;i++){perDay.push(0);cntDay.push(0)}
  ings.forEach(function(x){ing+=x.m;byTipo[x.k]=(byTipo[x.k]||0)+x.m;who[x.w==='esp'?'esp':'yo'].ing+=x.m});
  gass.forEach(function(x){
    gas+=x.m;byCat[x.c]=(byCat[x.c]||0)+x.m;who[x.w==='esp'?'esp':'yo'].gas+=x.m;
    if(x.ob){fijosPag+=x.m;paid[x.ob]=x;return}
    extras+=x.m;nExtras++;
    var k=Number(x.d.slice(8))-r.first;if(k>=0&&k<r.days){perDay[k]+=x.m;cntDay[k]++}
  });
  var phase=today<r.start?'future':(today>r.end?'past':'current');
  var obls=[],pend=0,seen={};
  oblsOf(cfg).forEach(function(ob){
    seen[ob.id]=1;var st=obState(ob,r);
    if(paid[ob.id])obls.push(Object.assign({},ob,{st:'paid',pay:paid[ob.id]}));
    else if(st==='on'){obls.push(Object.assign({},ob,{st:'pend'}));if(phase!=='past')pend+=ob.m}
    else if(st==='off')obls.push(Object.assign({},ob,{st:'off'}));
  });
  Object.keys(paid).forEach(function(id){if(!seen[id]){var x=paid[id];obls.push({id:id,n:x.n||'Obligación',m:x.m,c:x.c,st:'paid',pay:x,orphan:true})}});
  var meta=metaOf(cfg,ing),fijosTot=fijosPag+pend,libre=ing-meta-fijosTot-extras;
  var dayIdx=0,daysLeft=0,spentToday=0,dailyBudget=0,leftToday=0;
  if(phase==='current'){
    dayIdx=Number(today.slice(8))-r.first+1;daysLeft=r.days-dayIdx+1;spentToday=perDay[dayIdx-1];
    dailyBudget=Math.max(0,Math.floor((ing-meta-fijosTot-(extras-spentToday))/daysLeft));
    leftToday=dailyBudget-spentToday;
  }
  var disp=ing-meta-fijosTot,tope=ing>0?Math.max(0,disp/r.days):0;
  var status='empty',total=gas+pend;
  if(ing>0){
    if(total>ing)status='crit';
    else if(total>ing-meta)status='ahorro';
    else if(phase==='current'&&disp>0&&extras/disp>dayIdx/r.days+0.1)status='ritmo';
    else status='ok';
  }
  return {r:r,ings:ings,gass:gass,ing:ing,gas:gas,extras:extras,nExtras:nExtras,fijosPag:fijosPag,pend:pend,fijosTot:fijosTot,obls:obls,
    meta:meta,libre:libre,phase:phase,dayIdx:dayIdx,daysLeft:daysLeft,spentToday:spentToday,dailyBudget:dailyBudget,leftToday:leftToday,
    tope:tope,status:status,perDay:perDay,cntDay:cntDay,byCat:byCat,byTipo:byTipo,who:who,saved:ing-gas};
}
/*LOGIC-END*/
if(typeof module!=='undefined'&&module.exports){module.exports={qidOf:qidOf,qRange:qRange,qShift:qShift,qLabel:qLabel,summarize:summarize,money:money,metaOf:metaOf,obState:obState,monthIdx:monthIdx};return}

var CATS=[['mercado','Mercado'],['transporte','Transporte'],['comida','Comidas fuera'],['vivienda','Arriendo y hogar'],['servicios','Servicios y celular'],['salud','Salud'],['ocio','Ocio y salidas'],['ropa','Ropa y cuidado'],['deudas','Deudas y cuotas'],['otros','Otros']];
var TIPOS=[['sueldo','Sueldo'],['comision','Comisiones'],['otro','Otros ingresos']];
var CATN={},TIPON={};CATS.forEach(function(c){CATN[c[0]]=c[1]});TIPOS.forEach(function(c){TIPON[c[0]]=c[1]});
var TABS=['fijos','gastos','ingresos','ahorro'];
var P={
  mercado:'<path d="M3 4h2l2.3 10.3a1 1 0 0 0 1 .7h8.6a1 1 0 0 0 1-.8L19.5 7H6"/><circle cx="9.5" cy="19" r="1.3"/><circle cx="16.5" cy="19" r="1.3"/>',
  transporte:'<rect x="5" y="4" width="14" height="12" rx="2.5"/><path d="M5 11h14M8 16v2.5M16 16v2.5"/>',
  comida:'<path d="M6 3v6a2 2 0 0 0 4 0V3M8 11v10M16.5 21v-8h-2.5V9.5C14 6.8 15 4.5 16.5 3z"/>',
  vivienda:'<path d="M4 11l8-7 8 7M6 9.5V20h12V9.5M10 20v-5h4v5"/>',
  servicios:'<path d="M13 3L5 13.5h6L10 21l8-10.5h-6z"/>',
  salud:'<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>',
  ocio:'<path d="M12 4l2.4 5 5.6.8-4 3.9.9 5.5-4.9-2.6-4.9 2.6.9-5.5-4-3.9 5.6-.8z"/>',
  ropa:'<path d="M8.5 4L3.5 7l2 4 2-1v10h9V10l2 1 2-4-5-3a3.5 3.5 0 0 1-7 0z"/>',
  deudas:'<rect x="3" y="6" width="18" height="13" rx="2.5"/><path d="M3 10.5h18M7 15h4"/>',
  otros:'<circle cx="6" cy="12" r="1.4"/><circle cx="12" cy="12" r="1.4"/><circle cx="18" cy="12" r="1.4"/>',
  sueldo:'<rect x="3" y="6" width="18" height="12" rx="2.5"/><circle cx="12" cy="12" r="2.6"/><path d="M6.5 9.5v5M17.5 9.5v5"/>',
  comision:'<path d="M4 17l5-5 4 3 7-8M15 7h5v5"/>',
  otro:'<path d="M12 5v14M5 12h14"/>',
  lista:'<path d="M10 6h10M10 12h10M10 18h10M4 6l1.2 1.2L7.5 5M4 12l1.2 1.2L7.5 11M4 18l1.2 1.2L7.5 17"/>',
  edit:'<path d="M4 20h4L19 9l-4-4L4 16zM13.5 6.5l4 4"/>',
  del:'<path d="M5 7h14M10 7V4.5h4V7M7 7l1 13h8l1-13M10 11v5M14 11v5"/>',
  ok:'<circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.8 2.8L16 9.5"/>',
  warn:'<path d="M12 4l9 16H3zM12 10v4.5M12 17.2v.3"/>',
  crit:'<circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5M12 16.2v.3"/>',
  clock:'<circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3 2"/>',
  piggy:'<path d="M4 12a7 6 0 0 1 7-6h3l3-2v3.5a6 6 0 0 1 2 3.5h1.5v3H19a6 6 0 0 1-2 2.3V19h-3v-1.5h-3V19H8v-2.2A6 6 0 0 1 4 12z"/><circle cx="15.5" cy="10.5" r=".6"/>'
};
function ic(k){return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">'+(P[k]||P.otros)+'</svg>'}
var HUES={mercado:150,transporte:205,comida:24,vivienda:265,servicios:42,salud:350,ocio:300,ropa:185,deudas:228,otros:320,sueldo:150,comision:168,otro:200,ok:158};
function tile(k){return '<span class="ico" style="--h:'+(HUES[k]!=null?HUES[k]:320)+'">'+ic(k)+'</span>'}
function nm(w){var n=(S.cfg&&S.cfg.nombres)||{};return w==='esp'?(n.esp||'Mi pareja'):(n.yo||'Yo')}
function isSolo(){return !!S.cfg&&S.cfg.modo==='solo'}
function named(){return !!(S.cfg&&S.cfg.nombres&&S.cfg.nombres.yo)}
function PL(a,b){return isSolo()?a:b}
function showPar(attr,on){document.querySelectorAll('['+attr+']').forEach(function(el){el.hidden=!on})}
function whoTag(w){var e=w==='esp';return '<span class="who"><i class="dot'+(e?' k2':'')+'"></i>'+esc(nm(e?'esp':'yo'))+'</span>'}
function applyNames(){
  var solo=isSolo(),a=nm('yo'),b=nm('esp');
  document.querySelectorAll('[data-who]').forEach(function(el){var t=(el.dataset.pre||'')+nm(el.dataset.who)+(el.dataset.post||'');if(el.textContent!==t)el.textContent=t});
  document.querySelectorAll('[data-solo]').forEach(function(el){var t=solo?el.dataset.solo:el.dataset.par;if(el.textContent!==t)el.textContent=t});
  showPar('data-par-only',!solo);
  var same=!solo&&a.charAt(0).toLowerCase()===b.charAt(0).toLowerCase();
  $('#av-yo').textContent=named()?(same?a.slice(0,2):a.charAt(0).toUpperCase()):'$';
  $('#av-esp').textContent=same?b.slice(0,2):b.charAt(0).toUpperCase();$('#av-esp').hidden=solo||!named();
  $('#brand-names').textContent=named()?(solo?a:a+' & '+b):'Tu plata clarita, quincena a quincena';
}
function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
function $(s){return document.querySelector(s)}
function clone(o){return JSON.parse(JSON.stringify(o))}
function uid(){return Date.now().toString(36)+Math.random().toString(36).slice(2,7)}
function checked(name){var el=document.querySelector('input[name="'+name+'"]:checked');return el?el.value:null}
function setRadio(name,v){var el=document.querySelector('input[name="'+name+'"][value="'+v+'"]');if(el)el.checked=true}

var TODAY=ymd(new Date());
var S={cfg:null,qs:{},cur:qidOf(TODAY),tab:'fijos',ready:false,mode:'loading',confirm:null,edit:null,obEdit:null,pay:null,selDay:null,readonly:false};
var store={col:null,exists:{},base:{cfg:null,qs:{}},pending:[],chain:Promise.resolve()};
var LS='mi-quincena:v1';

/* ---------- Guardado ---------- */
function applyOp(st,op){
  if(op.t==='cfg'){st.cfg=clone(op.val);return}
  var q=st.qs[op.qid]||(st.qs[op.qid]={ing:{},gas:{}});
  if(!q[op.kind])q[op.kind]={};
  if(op.val===null)delete q[op.kind][op.id];else q[op.kind][op.id]=clone(op.val);
}
function rebuild(){
  var st={cfg:store.base.cfg?clone(store.base.cfg):null,qs:clone(store.base.qs)};
  store.pending.forEach(function(op){applyOp(st,op)});
  S.cfg=st.cfg;S.qs=st.qs;
}
function saveLocal(){try{localStorage.setItem(LS,JSON.stringify(store.base))}catch(e){}}
function loadLocal(){try{var v=JSON.parse(localStorage.getItem(LS)||'null');if(v&&v.qs)store.base={cfg:v.cfg||null,qs:v.qs}}catch(e){}}
function wait(ms){return new Promise(function(r){setTimeout(r,ms)})}
function writeCloud(op){
  var q=op.t==='cfg'
    ?sb.from('docs').upsert({hogar_id:store.hid,id:'config',data:clone(op.val)})
    :sb.rpc('poner_item',{p_doc:op.qid,p_kind:op.kind,p_id:op.id,p_val:op.val===null?null:clone(op.val)});
  return q.then(function(r){if(r.error)throw r.error});
}
function commit(op){
  if(S.readonly){toast('Esta vista es solo de lectura.');return}
  if(S.mode!=='cloud'){applyOp(store.base,op);saveLocal();rebuild();render();return}
  store.pending.push(op);rebuild();render();
  store.chain=store.chain.then(function(){
    return writeCloud(op).catch(function(e){
      if(/Failed to fetch|NetworkError/i.test(String(e&&e.message)))return wait(600+Math.random()*600).then(function(){return writeCloud(op)});
      throw e;
    });
  }).then(function(){
    applyOp(store.base,op);
  },function(e){
    var code=e&&e.code;
    if(code==='PGRST301'||code===401||/JWT/i.test(String(e&&e.message)))toast('Tu sesión venció. Vuelve a entrar.');
    else toast('No se pudo guardar. Revisa tu conexión e inténtalo de nuevo.');
  }).then(function(){
    var i=store.pending.indexOf(op);if(i>=0)store.pending.splice(i,1);
    rebuild();render();
  });
}
function saveCfg(mut){
  var c=clone(S.cfg||{sueldo:0,sueldoEsp:0,metaTipo:'pct',metaValor:10});
  mut(c);commit({t:'cfg',val:c});
}
function startLocal(msg){
  S.mode='local';loadLocal();S.ready=true;rebuild();
  var n=$('#notice');n.innerHTML=ic('warn')+'<span>'+msg+'</span>';n.hidden=false;
  syncForms(true);showView('app');render();
}

/* ---------- Cuenta con correo y espacio compartido (Supabase) ---------- */
var sb=null,APPCFG=window.PLATICA_CONFIG||{};
function showView(v){
  S.view=v;$('#scr-load').hidden=v!=='loading';$('#scr-auth').hidden=v!=='auth';$('#scr-hogar').hidden=v!=='hogar';$('#app-main').hidden=v!=='app';
}
function setMsg(sel,text,kind){var el=$(sel);el.hidden=!text;el.textContent=text||'';el.className='msg'+(kind?' '+kind:'')}
function errText(e){
  var m=String(e&&e.message||e||'');
  if(/Invalid login credentials/i.test(m))return 'Correo o contraseña incorrectos.';
  if(/Email not confirmed/i.test(m))return 'Falta confirmar tu correo. Abre el mensaje que te enviamos y toca el enlace.';
  if(/already registered/i.test(m))return 'Ese correo ya tiene cuenta. Entra con tu contraseña.';
  if(/rate limit|too many|security purposes/i.test(m))return 'Demasiados intentos seguidos. Espera un minuto y vuelve a probar.';
  if(/at least 6|Password should/i.test(m))return 'La contraseña debe tener al menos 6 caracteres.';
  if(/valid email|invalid format/i.test(m))return 'Revisa que el correo esté bien escrito.';
  if(/Failed to fetch|NetworkError|network/i.test(m))return 'No hay conexión. Revisa tu internet e inténtalo de nuevo.';
  if(/CODIGO_NO_EXISTE/.test(m))return 'Ese código no existe. Revísalo con tu pareja.';
  if(/ESPACIO_LLENO/.test(m))return 'Ese espacio ya tiene dos personas.';
  return 'No se pudo completar. Inténtalo de nuevo.';
}
function authMode(m){
  S.authMode=m;setMsg('#au-msg','');
  document.querySelectorAll('.gtab').forEach(function(b){b.setAttribute('aria-selected',b.dataset.au===m?'true':'false')});
  $('#au-tabs').hidden=m==='forgot'||m==='recover';
  $('#au-email-f').hidden=m==='recover';$('#au-pass-f').hidden=m==='forgot';
  $('#au-pass-l').textContent=m==='recover'?'Nueva contraseña':'Contraseña';
  $('#au-pass').autocomplete=m==='in'?'current-password':'new-password';
  $('#au-submit').textContent={'in':'Entrar','up':'Crear mi cuenta','forgot':'Enviarme el enlace','recover':'Guardar contraseña'}[m];
  $('#au-forgot').textContent=m==='in'||m==='up'?'Olvidé mi contraseña':'Volver a entrar';
  $('#au-forgot').hidden=m==='recover';
  $('#au-sub').textContent={'in':'Tus cuentas claras, quincena a quincena.','up':'Crea tu cuenta con tu correo y una contraseña.','forgot':'Escribe tu correo y te enviamos un enlace para cambiar la contraseña.','recover':'Escribe tu nueva contraseña.'}[m];
}
function authSubmit(){
  var email=$('#au-email').value.trim(),pass=$('#au-pass').value,m=S.authMode,p;
  setMsg('#au-msg','');
  if(m!=='recover'&&!/^\S+@\S+\.\S+$/.test(email)){setMsg('#au-msg','Escribe tu correo completo.','err');return}
  if(m!=='forgot'&&pass.length<6){setMsg('#au-msg','La contraseña debe tener al menos 6 caracteres.','err');return}
  if(m==='in')p=sb.auth.signInWithPassword({email:email,password:pass});
  else if(m==='up')p=sb.auth.signUp({email:email,password:pass,options:{emailRedirectTo:location.origin}});
  else if(m==='forgot')p=sb.auth.resetPasswordForEmail(email,{redirectTo:location.origin});
  else p=sb.auth.updateUser({password:pass});
  $('#au-submit').disabled=true;
  p.then(function(r){
    if(r.error)throw r.error;
    if(m==='up'){
      var u=r.data&&r.data.user;
      if(u&&u.identities&&u.identities.length===0){authMode('in');setMsg('#au-msg','Ese correo ya tiene cuenta. Entra con tu contraseña.','err')}
      else if(!(r.data&&r.data.session))setMsg('#au-msg','Te enviamos un correo a '+email+'. Ábrelo y toca el enlace para activar tu cuenta.','ok');
    }else if(m==='forgot')setMsg('#au-msg','Si ese correo tiene cuenta, ya te llegó un enlace para cambiar la contraseña.','ok');
    else if(m==='recover'){S.recover=false;$('#au-pass').value='';toast('Contraseña cambiada');enter()}
  }).catch(function(e){setMsg('#au-msg',errText(e),'err')}).then(function(){$('#au-submit').disabled=false});
}
function dropChannel(){if(store.ch){try{sb.removeChannel(store.ch)}catch(e){}store.ch=null}}
function teardown(){
  dropChannel();store.hid=null;store.base={cfg:null,qs:{}};store.pending=[];S.ready=false;S.codigo='';S.mode='loading';rebuild();
}
function fillBase(rows){
  var qs={},cfg=null;
  (rows||[]).forEach(function(r){if(r.id==='config')cfg=r.data;else if(String(r.id).indexOf('q-')===0)qs[r.id]=r.data||{ing:{},gas:{}}});
  store.base={cfg:cfg,qs:qs};rebuild();
}
function reload(){
  var hid=store.hid;
  return sb.from('docs').select('id,data').eq('hogar_id',hid).then(function(r){if(r.error)throw r.error;if(store.hid===hid)fillBase(r.data)});
}
function preselectWho(){
  var soy=null;try{soy=localStorage.getItem(LS+':soy')}catch(e){}
  if(soy==='esp'){setRadio('gas-w','esp');setRadio('ing-w','esp')}
}
function openHogar(h){
  store.hid=h.id;S.codigo=h.codigo||'';S.mode='cloud';
  return reload().then(function(){
    dropChannel();
    store.ch=sb.channel('docs-'+store.hid).on('postgres_changes',{event:'*',schema:'public',table:'docs',filter:'hogar_id=eq.'+store.hid},function(p){
      var row=p&&p['new'];if(!row||!row.id)return;
      if(row.id==='config')store.base.cfg=row.data;else if(String(row.id).indexOf('q-')===0)store.base.qs[row.id]=row.data||{ing:{},gas:{}};
      rebuild();render();
    }).subscribe();
    S.ready=true;S.cur=qidOf(TODAY);preselectWho();syncForms(true);showView('app');render();
  });
}
function enter(){
  if(!S.user)return;
  showView('loading');
  sb.rpc('mi_espacio').then(function(r){
    if(r.error)throw r.error;
    if(!r.data||!r.data.id){setMsg('#hg-msg','');showView('hogar');return}
    return openHogar(r.data);
  }).catch(function(e){
    var m=String(e&&e.message||'');
    showView('auth');authMode('in');
    setMsg('#au-msg',/mi_espacio|schema cache|does not exist/i.test(m)?'La base de datos aún no está preparada: falta ejecutar schema.sql en Supabase.':errText(e),'err');
  });
}
function boot(){
  render();
  var ok=APPCFG.supabaseUrl&&APPCFG.supabaseKey&&window.supabase&&window.supabase.createClient;
  if(!ok){startLocal('Modo de prueba: el registro con correo aún no está conectado. Los datos se guardan solo en este dispositivo.');return}
  sb=window.supabase.createClient(APPCFG.supabaseUrl,APPCFG.supabaseKey);
  authMode('in');
  sb.auth.onAuthStateChange(function(ev,session){
    setTimeout(function(){
      var u=session&&session.user||null;
      if(ev==='PASSWORD_RECOVERY'){S.recover=true;S.user=u;showView('auth');authMode('recover');return}
      if(u){
        if(S.recover){S.user=u;return}
        var nuevo=!S.user||S.user.id!==u.id||S.view==='auth';
        S.user=u;if(nuevo)enter();
      }else{S.user=null;S.recover=false;teardown();showView('auth');if(S.authMode==='recover'||S.authMode==='forgot')authMode('in')}
    },0);
  });
}

/* ---------- Utilidades de interfaz ---------- */
var toastT;
function toast(m){var t=$('#toast');t.textContent=m;t.classList.add('on');clearTimeout(toastT);toastT=setTimeout(function(){t.classList.remove('on')},2800)}
function fmtMoneyInput(el){var v=digits(el.value);el.value=v?v.toLocaleString('es-CO'):''}
function defDate(){var r=qRange(S.cur);return TODAY>=r.start&&TODAY<=r.end?TODAY:(TODAY>r.end?r.end:r.start)}
function syncForms(force){
  ['#gas-fecha','#ing-fecha'].forEach(function(s){var el=$(s);if(force||!el.value||qidOf(el.value)!==S.cur)el.value=defDate()});
  if(force&&!S.obEdit)$('#obl-q').value=String(qRange(S.cur).h);
}
function setTab(t,scroll){
  S.tab=t;TABS.forEach(function(k){
    $('#p-'+k).hidden=k!==t;$('#t-'+k).setAttribute('aria-selected',k===t?'true':'false');
  });
  try{localStorage.setItem(LS+':tab',t)}catch(e){}
  if(scroll)$('#p-'+t).scrollIntoView({block:'start'});
}
function goQ(qid){S.cur=qid;S.selDay=null;S.confirm=null;S.pay=null;cancelEdit('gas');cancelEdit('ing');syncForms(true);render()}
function curSm(){return summarize(S.qs[S.cur]||{},S.cfg,S.cur,TODAY)}

/* ---------- Pintado ---------- */
function render(){
  var sm=curSm();
  applyNames();renderTop(sm);renderHero(sm);renderFijos(sm);renderGastos(sm);renderIngresos(sm);renderAhorro(sm);
  var anyIng=Object.keys(S.qs).some(function(id){return vals(S.qs[id].ing).length>0});
  var c=S.cfg||{};
  $('#onboard').hidden=!(S.ready&&!S.readonly&&!c.listo&&!c.sueldo&&!anyIng);
  var off=!S.ready||S.readonly;
  ['#gas-submit','#ing-submit','#cfg-save','#obl-submit'].forEach(function(s){$(s).disabled=off});
}
function renderTop(sm){
  $('#q-label').textContent=qLabel(S.cur);
  $('#q-sub').textContent=(sm.r.h===1?'Primera':'Segunda')+' · '+(sm.phase==='current'?('día '+sm.dayIdx+' de '+sm.r.days):(sm.phase==='past'?'cerrada':'por empezar'));
  $('#q-today').hidden=S.cur===qidOf(TODAY);
}
function renderHero(sm){
  var st={ok:['ok','ok',PL('Vas bien','Van bien')],ritmo:['warn','warn',PL('Vas gastando rápido','Van gastando rápido')],ahorro:['warn','warn',PL('Estás usando el ahorro','Están usando el ahorro')],crit:['crit','crit','Sale más de lo que entra']}[sm.status];
  var duo=esc(nm('yo'))+' y '+esc(nm('esp')),yo=esc(nm('yo')),past=sm.phase==='past';
  var label=!named()?(past?'Lo que quedó libre':'Libre para gastar esta quincena'):(isSolo()?(past?'A '+yo+' le quedó libre':yo+' tiene libre para gastar'):(past?'A '+duo+' les quedó libre':duo+' tienen libre para gastar'));
  var sub;
  if(!S.ready)sub='Cargando tus datos…';
  else if(sm.ing===0)sub=(sm.fijosTot>0?'Esta quincena hay '+money(sm.fijosTot)+' en obligaciones. ':'')+'Registra los ingresos para ver cuánto '+PL('puedes','pueden')+' gastar.';
  else sub='Entraron '+money(sm.ing)+' y se apartan '+money(sm.meta)+' de ahorro.'+(sm.pend>0?' Faltan por pagar '+money(sm.pend)+' de obligaciones, ya descontados.':(sm.fijosPag>0?' Obligaciones al día.':''));
  var side='';
  if(S.ready&&sm.ing===0){
    side='<div class="k">Primer paso</div><div class="d">Anota lo que entra en la quincena: sueldos, comisiones u otros ingresos.</div><button class="btn small" type="button" data-act="go-ing">Registrar ingreso</button>';
  }else if(sm.phase==='current'){
    side=sm.leftToday>=0
      ?'<div class="k">'+PL('Hoy puedes gastar','Hoy pueden gastar')+'</div><div class="v">'+money(sm.leftToday)+'</div>'
      :'<div class="k">'+PL('Hoy te pasaste por','Hoy se pasaron por')+'</div><div class="v">'+money(-sm.leftToday)+'</div>';
    side+='<div class="d">Tope de hoy '+money(sm.dailyBudget)+' en extras · '+(sm.daysLeft===1?'último día':'quedan '+sm.daysLeft+' días')+'</div>';
  }else if(sm.phase==='past'){
    var okm=sm.saved>=sm.meta;
    side='<div class="k">'+PL('Ahorraste','Ahorraron')+'</div><div class="v">'+money(Math.max(0,sm.saved))+'</div><div class="d">Meta '+money(sm.meta)+' · '+(okm?'cumplida':'faltaron '+money(sm.meta-Math.max(0,sm.saved)))+'</div>';
  }else{
    side='<div class="k">Quincena futura</div><div class="d">Empieza el '+dayLabel(sm.r.start)+'. Ya puedes ver las obligaciones que vienen.</div>';
  }
  var fSeg=Math.min(sm.fijosTot,sm.ing),gSeg=Math.max(0,Math.min(sm.extras,sm.ing-fSeg));
  var aSeg=Math.max(0,Math.min(sm.meta,sm.ing-sm.fijosTot-sm.extras)),lSeg=Math.max(0,sm.libre);
  function seg(c,v){return v>0?'<span class="'+c+'" style="flex:'+v+' 0 0"></span>':''}
  var split=sm.ing>0?seg('f',fSeg)+seg('g',gSeg)+seg('a',aSeg)+seg('l',lSeg):'';
  $('#hero').innerHTML=
    '<div class="hero-top"><div><div class="hero-label">'+label+'</div><div class="hero-big">'+money(sm.libre)+'</div><div class="hero-sub">'+sub+'</div>'+
    (st?'<div class="pill '+st[0]+'">'+ic(st[1])+st[2]+'</div>':'')+'</div><div class="today">'+side+'</div></div>'+
 '<div class="hero-card"><div class="split" role="img" aria-label="Reparto de los ingresos: obligaciones '+money(sm.fijosTot)+', gastos extra '+money(sm.extras)+', ahorro '+money(aSeg)+', libre '+money(lSeg)+'">'+split+'</div>'+
    '<div class="legend">'+
    '<div><div class="k"><i style="background:var(--seg-fijo)"></i>Obligaciones</div><div class="v">'+money(sm.fijosTot)+'</div></div>'+
    '<div><div class="k"><i style="background:var(--seg-gasto)"></i>Gastos extra</div><div class="v">'+money(sm.extras)+'</div></div>'+
    '<div><div class="k"><i style="background:var(--seg-ahorro)"></i>Ahorro apartado</div><div class="v">'+money(aSeg)+'</div></div>'+
    '<div><div class="k"><i style="background:var(--seg-libre)"></i>Libre</div><div class="v">'+money(lSeg)+'</div></div>'+
    '</div></div>';
}
function opsHtml(kind,id){
  if(S.confirm===kind+':'+id)return '<div class="confirm"><span>¿Borrar?</span><button class="btn small" type="button" data-act="del-yes" data-kind="'+kind+'" data-id="'+id+'">Sí</button><button class="btn small" type="button" data-act="del-no">No</button></div>';
  return '<div class="ops"><button class="iconbtn" type="button" aria-label="Editar" data-act="edit" data-kind="'+kind+'" data-id="'+id+'">'+ic('edit')+'</button><button class="iconbtn" type="button" aria-label="Borrar" data-act="del" data-kind="'+kind+'" data-id="'+id+'">'+ic('del')+'</button></div>';
}
function listHtml(items,kind){
  var by={};items.forEach(function(x){(by[x.d]||(by[x.d]=[])).push(x)});
  return Object.keys(by).sort().reverse().map(function(d){
    var arr=by[d].sort(function(a,b){return (b.t||0)-(a.t||0)}),tot=arr.reduce(function(s,x){return s+x.m},0);
    return '<div class="day"><div class="day-h"><span>'+(d===TODAY?'Hoy · ':'')+dayLabel(d)+'</span><span class="num">'+money(tot)+'</span></div><ul class="movs">'+
      arr.map(function(x){
        var key=kind==='gas'?x.c:x.k,name=kind==='gas'?(CATN[x.c]||'Otros'):(TIPON[x.k]||'Otros ingresos');
        var sub=isSolo()?(x.n?name:''):((x.n?name+' · ':'')+whoTag(x.w));
        return '<li class="mov">'+tile(key)+'<div class="t"><strong>'+esc(x.n||name)+'</strong>'+(sub?'<small>'+sub+'</small>':'')+'</div><span class="amt'+(kind==='ing'?' in':'')+'">'+(kind==='ing'?'+':'')+money(x.m)+'</span>'+opsHtml(kind,esc(x.id))+'</li>';
      }).join('')+'</ul></div>';
  }).join('');
}
function obMeta(ob){
  var a=[];if(ob.aprox)a.push('aprox.');if(Number(ob.cada)===2)a.push('cada 2 meses');return a;
}
function renderFijos(sm){
  var keep=document.activeElement&&document.activeElement.id==='pay-monto';
  var rows=sm.obls.map(function(ob){
    if(ob.st==='paid'){
      var p=ob.pay;
      return '<li class="mov paid">'+tile('ok')+'<div class="t"><strong>'+esc(ob.n)+'</strong><small>'+(isSolo()?'Pagada':'Pagó '+whoTag(p.w))+' · '+dayLabel(p.d)+'</small></div><span class="amt">'+money(p.m)+'</span><button class="btn small" type="button" data-act="unpay" data-id="'+esc(p.id)+'">Deshacer</button></li>';
    }
    if(ob.st==='off')
      return '<li class="mov off">'+tile(ob.c)+'<div class="t"><strong>'+esc(ob.n)+'</strong><small>Cada 2 meses · este mes no toca</small></div><span class="amt">'+money(ob.m)+'</span><button class="btn small" type="button" data-act="ob-on" data-id="'+esc(ob.id)+'">Sí toca</button></li>';
    if(S.pay&&S.pay.id===ob.id){
      var w=S.pay.w;
      return '<li class="mov paying"><div class="payform"><strong>'+esc(ob.n)+(ob.aprox?' · ¿cuánto llegó esta vez?':'')+'</strong>'+
        '<div class="moneybox"><b>$</b><input type="text" id="pay-monto" inputmode="numeric" autocomplete="off" data-money value="'+(S.pay.m?S.pay.m.toLocaleString('es-CO'):'')+'" aria-label="Valor pagado"></div>'+
        (isSolo()?'':'<div class="seg two-opt"><label class="chip"><input type="radio" name="pay-w" id="pay-w-yo" value="yo"'+(w!=='esp'?' checked':'')+'><span>Pagó '+esc(nm('yo'))+'</span></label><label class="chip"><input type="radio" name="pay-w" id="pay-w-esp" value="esp"'+(w==='esp'?' checked':'')+'><span>Pagó '+esc(nm('esp'))+'</span></label></div>')+
        '<div class="actions"><button class="btn primary small" type="button" data-act="pay-ok">Marcar como pagada</button><button class="btn small" type="button" data-act="pay-no">Cancelar</button></div></div></li>';
    }
    var meta=['Pendiente'].concat(obMeta(ob)).join(' · ');
    return '<li class="mov">'+tile(ob.c)+'<div class="t"><strong>'+esc(ob.n)+'</strong><small>'+meta+(Number(ob.cada)===2?' · <button class="link" type="button" data-act="ob-off" data-id="'+esc(ob.id)+'">este mes no toca</button>':'')+'</small></div><span class="amt">'+money(ob.m)+'</span><button class="btn small primary" type="button" data-act="pay" data-id="'+esc(ob.id)+'">Pagar</button></li>';
  });
  rows.push('<li class="mov">'+tile('otros')+'<div class="t"><strong>Gastos extra</strong><small>'+(sm.nExtras?sm.nExtras+(sm.nExtras===1?' gasto anotado':' gastos anotados'):'Lo del día a día: mercado, salidas, imprevistos')+'</small></div><span class="amt">'+money(sm.extras)+'</span><button class="btn small" type="button" data-act="go-gas">Anotar</button></li>');
  var nOb=sm.obls.filter(function(o){return o.st!=='off'}).length,nPaid=sm.obls.filter(function(o){return o.st==='paid'}).length;
  var pendTxt=sm.phase==='past'?'Pagado '+money(sm.fijosPag):'Pagado '+money(sm.fijosPag)+' · por pagar '+money(sm.pend);
  $('#obls-list').innerHTML=(sm.fijosTot>0?'<div class="prog" role="img" aria-label="Pagado '+Math.round(sm.fijosPag/sm.fijosTot*100)+' % de las obligaciones"><span style="width:'+(sm.fijosPag/sm.fijosTot*100).toFixed(1)+'%"></span></div>':'')+(nOb?'':'<div class="empty" style="margin-bottom:10px"><strong>No hay obligaciones en esta quincena</strong>Agrega las de siempre en el formulario.</div>')+
    '<ul class="movs obs">'+rows.join('')+'</ul>'+
    '<div class="obtot" style="margin-top:12px"><span>Total de la quincena<small>'+pendTxt+' · extras '+money(sm.extras)+'</small></span><b>'+money(sm.fijosTot+sm.extras)+'</b></div>';
  $('#obls-aside').textContent=nOb?nPaid+' de '+nOb+' pagadas':'';
  if(keep){var el=$('#pay-monto');if(el){el.focus();try{el.setSelectionRange(el.value.length,el.value.length)}catch(e){}}}

  var all=oblsOf(S.cfg),groups=[[1,'Primera quincena · 1–15'],[2,'Segunda quincena · 16–fin de mes'],[0,'Las dos quincenas']];
  $('#obtpl-list').innerHTML=all.length?groups.map(function(g){
    var arr=all.filter(function(o){return (Number(o.q)||0)===g[0]});if(!arr.length)return '';
    var tot=arr.reduce(function(s,o){return s+o.m},0);
    return '<div class="day"><div class="day-h"><span>'+g[1]+'</span><span class="num">'+money(tot)+'</span></div><ul class="movs">'+arr.map(function(o){
      var sub=[CATN[o.c]||'Otros'].concat(obMeta(o)).concat(isSolo()?[]:['suele pagar '+esc(nm(o.w))]).join(' · ');
      return '<li class="mov">'+tile(o.c)+'<div class="t"><strong>'+esc(o.n)+'</strong><small>'+sub+'</small></div><span class="amt">'+money(o.m)+'</span>'+opsHtml('ob',esc(o.id))+'</li>';
    }).join('')+'</ul></div>';
  }).join(''):'<div class="empty"><strong>Aún no tienes obligaciones guardadas</strong>Agrega arriendo, servicios o cuotas y aparecerán solas cada quincena.</div>';
  var m1=0,m2=0;all.forEach(function(o){var q=Number(o.q)||0;if(q!==2)m1+=o.m;if(q!==1)m2+=o.m});
  $('#obtpl-aside').textContent=all.length?'1ª '+money(m1)+' · 2ª '+money(m2):'';
}
function renderGastos(sm){
  var r=sm.r,n=r.days,max=Math.max.apply(null,sm.perDay.concat([sm.tope])),top=max>0?max*1.2:1;
  var cols='',xs='';
  for(var i=0;i<n;i++){
    var d=r.start.slice(0,8)+pad(r.first+i),v=sm.perDay[i],over=sm.tope>0&&v>sm.tope;
    cols+='<button type="button" class="dcol'+(over?' over':'')+(S.selDay===d?' sel':'')+'" data-day="'+d+'" aria-label="'+dayLabel(d)+': '+money(v)+'"><span class="bar" style="height:'+(v>0?Math.max(2,v/top*100):0).toFixed(2)+'%"></span></button>';
    xs+='<span class="'+(d===TODAY?'is-today':'')+'">'+(r.first+i)+'</span>';
  }
  var ref=sm.tope>0?'<div class="ref" style="bottom:'+(sm.tope/top*100).toFixed(2)+'%"><span>Tope diario '+money(sm.tope)+'</span></div>':'';
  var rd=S.selDay&&qidOf(S.selDay)===S.cur?S.selDay:(sm.phase==='current'?TODAY:null);
  $('#daychart').innerHTML='<div class="plot" style="--n:'+n+'">'+cols+ref+'</div><div class="xaxis" style="--n:'+n+'">'+xs+'</div>'+
    '<div class="keys" style="margin-top:12px"><span><i style="background:var(--good)"></i>Dentro del tope</span><span><i style="background:var(--expense)"></i>Por encima del tope</span>'+(sm.tope>0?'<span><i class="dash"></i>Tope diario</span>':'')+'</div>'+
    '<div class="readout" id="readout" style="margin-top:10px" data-def="'+(rd||'')+'"></div>';
  readout(sm,rd);
  $('#chart-aside').textContent=sm.extras>0?'Promedio '+money(sm.extras/(sm.phase==='current'?sm.dayIdx:n))+' al día':'';
  var tot=sm.gas||1,cats=Object.keys(sm.byCat).sort(function(a,b){return sm.byCat[b]-sm.byCat[a]}),cmax=cats.length?sm.byCat[cats[0]]:1;
  $('#cat-list').innerHTML=cats.length?'<div class="cats">'+cats.map(function(c){
    var v=sm.byCat[c];
    return '<div class="cat">'+tile(c)+'<div><div class="nm"><span>'+(CATN[c]||'Otros')+'</span><small class="num">'+Math.round(v/tot*100)+' %</small></div><div class="track"><span style="width:'+(v/cmax*100).toFixed(1)+'%"></span></div></div><span class="amt">'+money(v)+'</span></div>';
  }).join('')+'</div>':'<div class="empty"><strong>Sin pagos todavía</strong>Aquí verás qué categorías se llevan más plata.</div>';
  var ex=sm.gass.filter(function(x){return !x.ob});
  $('#list-total').textContent=ex.length?ex.length+(ex.length===1?' gasto · ':' gastos · ')+money(sm.extras):'';
  $('#gas-list').innerHTML=ex.length?listHtml(ex,'gas'):'<div class="empty"><strong>Aún no hay gastos extra en esta quincena</strong>Anota el primero: cuánto fue, quién pagó y en qué.</div>';
}
function readout(sm,d){
  var el=$('#readout');if(!el)return;
  if(!d){el.innerHTML='<span>Pasa el cursor o toca un día para ver su gasto.</span>';return}
  var i=Number(d.slice(8))-sm.r.first,v=sm.perDay[i]||0,c=sm.cntDay[i]||0;
  el.innerHTML='<span>'+(d===TODAY?'Hoy · ':'')+dayLabel(d)+'</span><span><b>'+money(v)+'</b> en '+c+(c===1?' gasto':' gastos')+(sm.tope>0&&v>sm.tope?' · '+money(v-sm.tope)+' sobre el tope':'')+'</span>';
}
function renderIngresos(sm){
  $('#ing-total').textContent=sm.ing>0?money(sm.ing):'';
  var mx=Math.max.apply(null,TIPOS.map(function(t){return sm.byTipo[t[0]]||0}).concat([1]));
  $('#tipo-list').innerHTML='<div class="cats">'+TIPOS.map(function(t){
    var v=sm.byTipo[t[0]]||0;
    return '<div class="cat">'+tile(t[0])+'<div><div class="nm"><span>'+t[1]+'</span><small class="num">'+(sm.ing?Math.round(v/sm.ing*100):0)+' %</small></div><div class="track"><span style="width:'+(v/mx*100).toFixed(1)+'%;background:var(--income)"></span></div></div><span class="amt">'+money(v)+'</span></div>';
  }).join('')+'</div>'+(sm.ing>0&&!isSolo()?'<p class="hint" style="margin-top:12px">'+esc(nm('yo'))+' '+money(sm.who.yo.ing)+' · '+esc(nm('esp'))+' '+money(sm.who.esp.ing)+'</p>':'');
  $('#ing-list').innerHTML=sm.ings.length?listHtml(sm.ings,'ing'):'<div class="empty"><strong>Aún no hay ingresos en esta quincena</strong>Registra los sueldos, una comisión o cualquier otra entrada.</div>';
  var qs=$('#quick-sueldo'),c=S.cfg||{},btns='';
  if(S.ready&&!S.readonly){
    (isSolo()?['yo']:['yo','esp']).forEach(function(w){
      var s=Number(w==='yo'?c.sueldo:c.sueldoEsp)||0;
      var has=sm.ings.some(function(x){return x.k==='sueldo'&&(x.w==='esp'?'esp':'yo')===w});
      if(s>0&&!has)btns+='<button class="btn small primary" type="button" data-act="quick-sueldo" data-w="'+w+'">'+(named()?'Sueldo de '+esc(nm(w)):(w==='yo'?'Mi sueldo':'Sueldo de mi pareja'))+' '+money(s)+'</button>';
    });
  }
  qs.hidden=!btns;
  if(btns)qs.innerHTML='<p>Sueldo de esta quincena sin anotar:</p><div>'+btns+'</div>';
}
function renderAhorro(sm){
  var closed=0,nClosed=0;
  Object.keys(S.qs).forEach(function(id){var r=qRange(id);if(r.end<TODAY){var s=summarize(S.qs[id],S.cfg,id,TODAY);if(s.ing||s.gas){closed+=s.saved;nClosed++}}});
  var cfg=S.cfg||{},metaTxt=cfg.metaTipo==='monto'?'Monto fijo por quincena':((Number(cfg.metaValor)||0)+' % de lo que entra');
  var proj=sm.phase==='past'?sm.saved:sm.saved-sm.pend,saved=Math.max(0,proj),pct=sm.meta>0?Math.min(100,saved/sm.meta*100):0;
  $('#ahorro-stats').innerHTML=
    '<div class="stat"><div class="k">Meta de esta quincena</div><div class="v">'+money(sm.meta)+'</div><div class="d">'+(S.cfg&&S.cfg.metaValor!=null?metaTxt:'Define la meta en Ajustes')+'</div><div style="margin-top:10px"><button class="btn small" type="button" data-act="settings">Cambiar meta</button></div></div>'+
    '<div class="stat"><div class="k">'+(sm.phase==='past'?PL('Ahorraste en esta quincena','Ahorraron en esta quincena'):PL('Si no gastas más, ahorras','Si no gastan más, ahorran'))+'</div><div class="v">'+money(saved)+'</div><div class="track" role="img" aria-label="'+Math.round(pct)+' % de la meta"><span style="width:'+pct.toFixed(1)+'%"></span></div><div class="d" style="margin-top:6px">'+(sm.meta>0?(saved>=sm.meta?'Meta cubierta, con '+money(saved-sm.meta)+' de más':'Faltan '+money(sm.meta-saved)+' para la meta'):'Registra ingresos para calcularla')+(sm.phase!=='past'&&sm.pend>0?' · ya descontando lo que falta por pagar':'')+'</div></div>'+
    '<div class="stat"><div class="k">Ahorro acumulado</div><div class="v">'+money(closed)+'</div><div class="d">'+(nClosed?'Suma de '+nClosed+(nClosed===1?' quincena cerrada':' quincenas cerradas'):'Se suma al cerrar cada quincena')+'</div></div>';

  var a=sm.who.yo.gas,b=sm.who.esp.gas,t=a+b,half=t/2,diff=Math.round(a-half),A=esc(nm('yo')),B=esc(nm('esp'));
  if(t<=0)$('#mitades').innerHTML='<div class="empty"><strong>Aún no hay pagos en esta quincena</strong>Cuando marques quién pagó cada cosa, aquí verás si van a mitades.</div>';
  else{
    var verdict=Math.abs(diff)<1?'Van a mitades exactas.':(diff>0
      ?A+' ha pagado <b>'+money(diff)+'</b> más que la mitad. Para quedar parejos, '+B+' le pasa <b>'+money(diff)+'</b> a '+A+'.'
      :B+' ha pagado <b>'+money(-diff)+'</b> más que la mitad. Para quedar parejos, '+A+' le pasa <b>'+money(-diff)+'</b> a '+B+'.');
    var hrow=function(name,v,ingv,k){return '<div class="hrow"><div class="nm"><span><i class="dot '+k+'"></i>'+name+'</span><span>'+money(v)+' · '+Math.round(v/t*100)+' %</span></div><div class="htrack" role="img" aria-label="'+name+' pagó '+Math.round(v/t*100)+' % de los gastos"><span class="'+k+'" style="width:'+(v/t*100).toFixed(1)+'%"></span><i></i></div><small>Aportó '+money(ingv)+' en ingresos</small></div>'};
    $('#mitades').innerHTML='<div class="half">'+hrow(A,a,sm.who.yo.ing,'k1')+hrow(B,b,sm.who.esp.ing,'k2')+
      '<p class="hint">La raya marca la mitad: '+money(half)+' cada uno de '+money(t)+' pagados.</p><div class="verdict">'+verdict+'</div></div>';
  }

  var ids=Object.keys(S.qs).filter(function(id){var q=S.qs[id];return vals(q.ing).length||vals(q.gas).length});
  if(ids.indexOf(S.cur)<0)ids.push(S.cur);
  ids.sort().reverse();
  $('#hist').innerHTML='<div class="tablewrap"><table><thead><tr><th>Quincena</th><th>Ingresos</th><th>Gastos</th><th>Ahorro</th><th>Meta</th></tr></thead><tbody>'+
    ids.map(function(id){
      var s=summarize(S.qs[id],S.cfg,id,TODAY),tag;
      if(s.phase!=='past')tag='<span class="tag run">'+ic('clock')+(s.phase==='current'?'En curso':'Futura')+'</span>';
      else if(s.ing===0&&s.gas===0)tag='<span class="tag run">'+ic('clock')+'Sin datos</span>';
      else if(s.saved>=s.meta&&s.saved>=0)tag='<span class="tag ok">'+ic('ok')+'Cumplida</span>';
      else tag='<span class="tag no">'+ic('crit')+'Faltaron '+money(s.meta-s.saved)+'</span>';
      return '<tr data-q="'+id+'" class="'+(id===S.cur?'cur':'')+'"><td><button class="qbtn" type="button" data-q="'+id+'">'+qLabel(id)+'</button></td><td>'+money(s.ing)+'</td><td>'+money(s.gas)+'</td><td><b>'+money(s.saved)+'</b></td><td>'+tag+'</td></tr>';
    }).join('')+'</tbody></table></div>';
}

/* ---------- Formularios ---------- */
function cancelEdit(kind){
  if(S.edit&&S.edit.kind===kind)S.edit=null;
  if(kind==='gas'){$('#gas-title').textContent='Registrar un gasto extra';$('#gas-submit').textContent='Guardar gasto';$('#gas-cancel').hidden=true;$('#gas-monto').value='';$('#gas-nota').value=''}
  else{$('#ing-title').textContent='Registrar un ingreso';$('#ing-submit').textContent='Guardar ingreso';$('#ing-cancel').hidden=true;$('#ing-monto').value='';$('#ing-nota').value=''}
}
function startEdit(kind,id){
  var q=S.qs[S.cur],x=q&&q[kind]&&q[kind][id];if(!x)return;
  S.edit={kind:kind,qid:S.cur,id:id};S.confirm=null;
  var p=kind;
  $('#'+p+'-monto').value=x.m.toLocaleString('es-CO');$('#'+p+'-nota').value=x.n||'';$('#'+p+'-fecha').value=x.d;
  setRadio(kind==='gas'?'cat':'tipo',kind==='gas'?x.c:x.k);setRadio(p+'-w',x.w==='esp'?'esp':'yo');
  $('#'+p+'-title').textContent=kind==='gas'?'Editar gasto':'Editar ingreso';
  $('#'+p+'-submit').textContent='Guardar cambios';$('#'+p+'-cancel').hidden=false;
  setTab(kind==='gas'?'gastos':'ingresos');render();
  $('#f-'+p).scrollIntoView({block:'center'});$('#'+p+'-monto').focus();
}
function submitMov(kind){
  if(!S.ready||S.readonly)return;
  var p=kind,m=digits($('#'+p+'-monto').value),d=$('#'+p+'-fecha').value,n=$('#'+p+'-nota').value.trim().slice(0,60);
  if(!m){toast('Escribe un monto mayor que cero.');$('#'+p+'-monto').focus();return}
  if(!validYmd(d)){toast('Elige una fecha válida.');$('#'+p+'-fecha').focus();return}
  var val={m:m,d:d,n:n,t:Date.now(),w:!isSolo()&&checked(p+'-w')==='esp'?'esp':'yo'};
  if(kind==='gas')val.c=checked('cat')||'otros';else val.k=checked('tipo')||'otro';
  var qid=qidOf(d),ed=S.edit&&S.edit.kind===kind?S.edit:null,id=ed?ed.id:uid();
  if(ed&&ed.qid!==qid){commit({t:'item',qid:ed.qid,kind:kind,id:ed.id,val:null});id=uid()}
  cancelEdit(kind);
  commit({t:'item',qid:qid,kind:kind,id:id,val:val});
  toast(qid===S.cur?(kind==='gas'?'Gasto guardado':'Ingreso guardado'):'Guardado en la quincena '+qLabel(qid));
  syncForms(false);$('#'+p+'-monto').focus();
}
function cancelObEdit(){
  S.obEdit=null;$('#ob-title').textContent='Agregar una obligación fija';$('#obl-submit').textContent='Agregar obligación';$('#obl-cancel').hidden=true;
  $('#obl-nombre').value='';$('#obl-monto').value='';$('#obl-aprox').checked=false;$('#obl-cada').value='1';$('#obl-q').value=String(qRange(S.cur).h);
}
function startObEdit(id){
  var o=S.cfg&&S.cfg.obls&&S.cfg.obls[id];if(!o)return;
  S.obEdit=id;S.confirm=null;
  $('#obl-nombre').value=o.n;$('#obl-monto').value=Number(o.m).toLocaleString('es-CO');$('#obl-q').value=String(Number(o.q)||0);
  $('#obl-cada').value=Number(o.cada)===2?'2':'1';$('#obl-cat').value=CATN[o.c]?o.c:'otros';$('#obl-w').value=o.w==='esp'?'esp':'yo';$('#obl-aprox').checked=!!o.aprox;
  $('#ob-title').textContent='Editar obligación';$('#obl-submit').textContent='Guardar cambios';$('#obl-cancel').hidden=false;
  render();$('#f-ob').scrollIntoView({block:'center'});$('#obl-nombre').focus();
}
function submitOb(){
  if(!S.ready||S.readonly)return;
  var n=$('#obl-nombre').value.trim().slice(0,40),m=digits($('#obl-monto').value);
  if(!n){toast('Ponle un nombre a la obligación.');$('#obl-nombre').focus();return}
  if(!m){toast('Escribe el valor de la obligación.');$('#obl-monto').focus();return}
  var editing=S.obEdit,id=editing||('o'+uid()),cada=Number($('#obl-cada').value)===2?2:1,mi=monthIdx(qRange(S.cur));
  var q=Number($('#obl-q').value)||0,cat=$('#obl-cat').value,w=!isSolo()&&$('#obl-w').value==='esp'?'esp':'yo',aprox=$('#obl-aprox').checked;
  saveCfg(function(c){
    c.obls=c.obls||{};var old=c.obls[id]||{};
    c.obls[id]={n:n,m:m,q:q,cada:cada,c:cat,w:w,aprox:aprox,o:old.o||Date.now()};
    if(cada===2)c.obls[id].ref=old.ref!=null&&Number(old.cada)===2?old.ref:mi;
  });
  cancelObEdit();toast(editing?'Obligación actualizada':'Obligación agregada');
}
function openSettings(){
  var c=Object.assign({sueldo:0,sueldoEsp:0,metaTipo:'pct',metaValor:10},S.cfg||{});
  $('#cfg-sueldo').value=c.sueldo?Number(c.sueldo).toLocaleString('es-CO'):'';
  $('#cfg-sueldo-esp').value=c.sueldoEsp?Number(c.sueldoEsp).toLocaleString('es-CO'):'';
  var nn=c.nombres||{};$('#cfg-n-yo').value=nn.yo||'';$('#cfg-n-esp').value=nn.esp||'';
  $(c.modo==='solo'?'#cfg-modo-solo':'#cfg-modo-par').checked=true;showPar('data-cfg-par',c.modo!=='solo');
  $(c.metaTipo==='monto'?'#cfg-fijo':'#cfg-pct').checked=true;
  $('#cfg-valor').value=c.metaTipo==='monto'?Number(c.metaValor||0).toLocaleString('es-CO'):String(c.metaValor||0);
  cfgMode();
  $('#acct').hidden=S.mode!=='cloud'||!S.user;
  $('#acct-email').textContent=S.user?S.user.email:'';$('#acct-code').textContent=S.codigo||'';
  var d=$('#dlg');if(d.showModal)d.showModal();else d.setAttribute('open','');
}
function closeSettings(){var d=$('#dlg');if(d.close)d.close();else d.removeAttribute('open')}
function cfgMode(){
  var fijo=$('#cfg-fijo').checked;
  $('#cfg-valor-l').textContent=fijo?'Monto a ahorrar cada quincena':'Porcentaje a ahorrar';
  $('#cfg-pre').textContent=fijo?'$':'%';
}

/* ---------- Eventos ---------- */
$('#gas-cats').innerHTML=CATS.map(function(c,i){return '<label class="chip"><input type="radio" name="cat" id="cat-'+c[0]+'" value="'+c[0]+'"'+(i===0?' checked':'')+'><span>'+ic(c[0])+c[1]+'</span></label>'}).join('');
$('#ing-tipos').innerHTML=TIPOS.map(function(c,i){return '<label class="chip"><input type="radio" name="tipo" id="tipo-'+c[0]+'" value="'+c[0]+'"'+(i===0?' checked':'')+'><span>'+c[1]+'</span></label>'}).join('');
$('#obl-cat').innerHTML=CATS.map(function(c){return '<option value="'+c[0]+'">'+c[1]+'</option>'}).join('');$('#obl-cat').value='servicios';
document.addEventListener('input',function(e){
  var t=e.target;
  if(t.matches&&t.matches('[data-money]'))fmtMoneyInput(t);
  if(t.id==='pay-monto'&&S.pay)S.pay.m=digits(t.value);
  if(t.id==='cfg-valor'){if($('#cfg-fijo').checked)fmtMoneyInput(t);else t.value=String(Math.min(100,digits(t.value))||'')}
  if(t.id==='ob-meta')t.value=String(Math.min(99,digits(t.value))||'');
});
document.addEventListener('change',function(e){
  if(e.target.name==='cfg-tipo'){$('#cfg-valor').value='';cfgMode()}
  if(e.target.name==='cfg-modo')showPar('data-cfg-par',e.target.value!=='solo');
  if(e.target.name==='ob-modo')showPar('data-ob-par',e.target.value!=='solo');
  if(e.target.name==='pay-w'&&S.pay)S.pay.w=e.target.value;
});
$('#f-gas').addEventListener('submit',function(e){e.preventDefault();submitMov('gas')});
$('#f-ing').addEventListener('submit',function(e){e.preventDefault();submitMov('ing')});
$('#f-ob').addEventListener('submit',function(e){e.preventDefault();submitOb()});
$('#gas-cancel').addEventListener('click',function(){cancelEdit('gas');syncForms(true)});
$('#ing-cancel').addEventListener('click',function(){cancelEdit('ing');syncForms(true)});
$('#obl-cancel').addEventListener('click',cancelObEdit);
$('#q-prev').addEventListener('click',function(){goQ(qShift(S.cur,-1))});
$('#q-next').addEventListener('click',function(){goQ(qShift(S.cur,1))});
$('#q-today').addEventListener('click',function(){goQ(qidOf(TODAY))});
$('#btn-settings').addEventListener('click',openSettings);
$('#cfg-cancel').addEventListener('click',closeSettings);
$('#f-cfg').addEventListener('submit',function(e){
  e.preventDefault();if(!S.ready||S.readonly)return;
  var fijo=$('#cfg-fijo').checked,s1=digits($('#cfg-sueldo').value),s2=digits($('#cfg-sueldo-esp').value),v=digits($('#cfg-valor').value);
  var n1=$('#cfg-n-yo').value.trim().slice(0,14),n2=$('#cfg-n-esp').value.trim().slice(0,14),modo=checked('cfg-modo')==='solo'?'solo':'pareja';
  saveCfg(function(c){
    var on=c.nombres||{};c.modo=modo;c.nombres={yo:n1||on.yo||'',esp:n2||on.esp||''};c.sueldo=s1;c.sueldoEsp=s2;c.metaTipo=fijo?'monto':'pct';c.metaValor=fijo?v:Math.min(100,v);c.listo=true;
  });
  closeSettings();toast('Ajustes guardados');
});
$('#onboard').addEventListener('submit',function(e){
  e.preventDefault();if(!S.ready||S.readonly)return;
  var nombre=$('#ob-nombre').value.trim().slice(0,14),modo=checked('ob-modo')==='pareja'?'pareja':'solo';
  var pareja=modo==='pareja'?($('#ob-nombre-esp').value.trim().slice(0,14)||'Mi pareja'):'';
  var sueldo=digits($('#ob-sueldo').value),esp=modo==='pareja'?digits($('#ob-sueldo-esp').value):0,meta=Math.min(99,digits($('#ob-meta').value));
  if(!nombre){toast('Escribe tu nombre para empezar.');$('#ob-nombre').focus();return}
  saveCfg(function(c){c.modo=modo;c.nombres={yo:nombre,esp:pareja};c.sueldo=sueldo;c.sueldoEsp=esp;c.metaTipo='pct';c.metaValor=meta;c.listo=true});
  var hoy=qidOf(TODAY);S.cur=hoy;
  if(sueldo)commit({t:'item',qid:hoy,kind:'ing',id:uid(),val:{m:sueldo,k:'sueldo',d:TODAY,n:'',w:'yo',t:Date.now()}});
  if(esp)commit({t:'item',qid:hoy,kind:'ing',id:uid(),val:{m:esp,k:'sueldo',d:TODAY,n:'',w:'esp',t:Date.now()+1}});
  toast('Listo, '+nombre+'. Ya puedes anotar ingresos, pagos y gastos.');
});
var TABICO={fijos:'lista',gastos:'mercado',ingresos:'comision',ahorro:'piggy'};
document.querySelectorAll('.tab').forEach(function(b){
  b.innerHTML=ic(TABICO[b.dataset.tab])+'<span>'+b.textContent+'</span>';
  b.addEventListener('click',function(){setTab(b.dataset.tab,window.matchMedia('(max-width:520px)').matches)});
});
document.addEventListener('click',function(e){
  var b=e.target.closest('[data-act],[data-day],[data-q]');if(!b)return;
  if(b.dataset.day){S.selDay=S.selDay===b.dataset.day?null:b.dataset.day;render();return}
  if(b.dataset.q&&!b.dataset.act){goQ(b.dataset.q);window.scrollTo({top:0,behavior:'smooth'});return}
  var a=b.dataset.act,kind=b.dataset.kind,id=b.dataset.id,sm;
  if(a==='go-ing'){setTab('ingresos',true);$('#ing-monto').focus()}
  else if(a==='go-gas'){setTab('gastos',true);$('#gas-monto').focus()}
  else if(a==='settings')openSettings();
  else if(a==='edit'){if(kind==='ob')startObEdit(id);else startEdit(kind,id)}
  else if(a==='del'){S.confirm=kind+':'+id;render()}
  else if(a==='del-no'){S.confirm=null;render()}
  else if(a==='del-yes'){
    S.confirm=null;
    if(kind==='ob'){if(S.obEdit===id)cancelObEdit();saveCfg(function(c){if(c.obls)delete c.obls[id]});toast('Obligación borrada');return}
    if(S.edit&&S.edit.id===id)cancelEdit(kind);
    commit({t:'item',qid:S.cur,kind:kind,id:id,val:null});toast(kind==='gas'?'Gasto borrado':'Ingreso borrado');
  }
  else if(a==='pay'){
    if(!S.ready||S.readonly)return;
    sm=curSm();var ob=sm.obls.filter(function(o){return o.id===id})[0];if(!ob)return;
    S.pay={id:id,m:ob.m,w:!isSolo()&&ob.w==='esp'?'esp':'yo'};render();
    var el=$('#pay-monto');if(el){el.focus();try{el.select()}catch(err){}}
  }
  else if(a==='pay-no'){S.pay=null;render()}
  else if(a==='pay-ok'){
    if(!S.pay)return;
    sm=curSm();var o2=sm.obls.filter(function(o){return o.id===S.pay.id})[0],m=S.pay.m;
    if(!o2){S.pay=null;render();return}
    if(!m){toast('Escribe el valor pagado.');return}
    var val={m:m,d:defDate(),n:o2.n,c:CATN[o2.c]?o2.c:'otros',w:S.pay.w==='esp'?'esp':'yo',ob:o2.id,t:Date.now()};
    S.pay=null;commit({t:'item',qid:S.cur,kind:'gas',id:uid(),val:val});toast(o2.n+': pago registrado');
  }
  else if(a==='unpay'){commit({t:'item',qid:S.cur,kind:'gas',id:id,val:null});toast('Pago deshecho')}
  else if(a==='ob-on'||a==='ob-off'){
    var mi=monthIdx(qRange(S.cur));
    saveCfg(function(c){if(c.obls&&c.obls[id])c.obls[id].ref=a==='ob-on'?mi:mi+1});
  }
  else if(a==='quick-sueldo'){
    var w=b.dataset.w==='esp'?'esp':'yo',c=S.cfg||{},s=Number(w==='yo'?c.sueldo:c.sueldoEsp)||0;if(!s)return;
    commit({t:'item',qid:S.cur,kind:'ing',id:uid(),val:{m:s,k:'sueldo',d:defDate(),n:'',w:w,t:Date.now()}});toast('Sueldo registrado');
  }
});
$('#daychart').addEventListener('mouseover',function(e){
  var b=e.target.closest('[data-day]');if(b)readout(curSm(),b.dataset.day);
});
$('#daychart').addEventListener('mouseleave',function(){
  var el=$('#readout');if(el)readout(curSm(),el.dataset.def||null);
});
$('#daychart').addEventListener('focusin',function(e){
  var b=e.target.closest('[data-day]');if(b)readout(curSm(),b.dataset.day);
});

document.querySelectorAll('.gtab').forEach(function(b){b.addEventListener('click',function(){authMode(b.dataset.au)})});
$('#f-auth').addEventListener('submit',function(e){e.preventDefault();if(sb)authSubmit()});
$('#au-forgot').addEventListener('click',function(){authMode(S.authMode==='in'||S.authMode==='up'?'forgot':'in')});
function hogarCall(p,soy,btn){
  setMsg('#hg-msg','');$(btn).disabled=true;
  p.then(function(r){
    if(r.error)throw r.error;
    try{localStorage.setItem(LS+':soy',soy)}catch(e){}
    showView('loading');return openHogar(r.data);
  }).catch(function(e){showView('hogar');setMsg('#hg-msg',errText(e),'err')}).then(function(){$(btn).disabled=false});
}
$('#hg-crear').addEventListener('click',function(){hogarCall(sb.rpc('crear_espacio'),'yo','#hg-crear')});
$('#f-join').addEventListener('submit',function(e){
  e.preventDefault();var code=$('#hg-code').value.trim().toUpperCase();
  if(code.length<6){setMsg('#hg-msg','El código tiene 6 letras y números.','err');return}
  hogarCall(sb.rpc('unirse_espacio',{p_codigo:code}),'esp','#hg-join');
});
$('#hg-out').addEventListener('click',function(){sb.auth.signOut()});
$('#acct-out').addEventListener('click',function(){closeSettings();sb.auth.signOut()});
$('#acct-copy').addEventListener('click',function(){
  var c=S.codigo||'';
  if(navigator.clipboard&&navigator.clipboard.writeText)navigator.clipboard.writeText(c).then(function(){toast('Código copiado')},function(){toast('Código: '+c)});
  else toast('Código: '+c);
});
document.addEventListener('visibilitychange',function(){
  if(!document.hidden&&S.mode==='cloud'&&store.hid&&!store.pending.length)reload().then(render).catch(function(){});
});

var h=(location.hash||'').slice(1),saved=null;
try{saved=localStorage.getItem(LS+':tab')}catch(e){}
setTab(TABS.indexOf(h)>=0?h:(TABS.indexOf(saved)>=0?saved:'fijos'));syncForms(true);boot();
})();
</script>
</body>
</html>
